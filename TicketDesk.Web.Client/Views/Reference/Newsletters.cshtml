@using TicketDesk.Domain.Model
@using TicketDesk.Core.Resources
@using TicketDesk.Localization.Client
@model IEnumerable<Reference>

@section title{ @ViewLang.NewsLetters }
@section css
{
    <link href="~/src/libs/slick/slick.css" rel="stylesheet" />
    <link href="~/src/libs/slick/slick-theme.css" rel="stylesheet" />

}

@if (Model.Count() > 0)
{
    <div class="img-content">
        <div class="img-detail slick-img">
            @foreach (var reference in Model)
            {
                <div class="item active">
                    <img src="@reference.ImageLink" alt="@Resources.View_Reference_CannotLoadContent
                                     @Resources.View_Reference_TryAgain.">
                    <p class="info newsletter">
                        <span>@ViewLang.NewsLetters</span> |
                        Last update by <span>@reference.LastUpdateBy</span>
                        <span>@reference.LastUpdateDate.ToString("dd MMM yyyy hh:mm:ss tt")</span>
                    </p>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="img-detail">
        <p class="img-error">@Resources.View_Reference_NoInformation</p>
    </div>
}

@section scripts {
    <script src="~/src/libs/slick/slick.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('.slick-img').slick({
                infinite: true,
                speed: 500,
                fade: true,
                cssEase: 'linear'
            });
        });
    </script>
}