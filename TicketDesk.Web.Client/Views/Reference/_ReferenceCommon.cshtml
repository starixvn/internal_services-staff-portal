@using TicketDesk.Localization.Client
@model TicketDesk.Domain.Model.Reference

<div class="img-content">
    @if (Model == null)
    {
        <div class="img-detail">
            <p class="img-error">@Resources.View_Reference_NoInformation</p>
        </div>
    }
    else
    {
        <div class="img-detail">
            <img src="@(Model.ImageLink)" alt="@Resources.View_Reference_CannotLoadContent
                 @Resources.View_Reference_TryAgain" />
        </div>
        <p class="info">
            <span>@ViewData["name"]</span> |
            Last update by <span>@Model.LastUpdateBy</span>
            <span>@Model.LastUpdateDate.ToString("dd MMM yyyy hh:mm:ss tt")</span>
        </p>
    }
</div>