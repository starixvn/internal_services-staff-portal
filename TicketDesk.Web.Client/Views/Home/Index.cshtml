@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Home.HomeViewModel

@section title{ @Resources.Common_App_Title }

@section scripts
{
    <script type="text/javascript" src="~/src/js/home/home.js"></script>
}

<div class="panel feature">
    <div class="panel-heading text-info">@Resources.Views_Home_Index_MyOpenningIssue</div>
    <div class="panel-body">
        @if (Model.MyOpenningIssues.TicketGroups.Any())
        {
            @Html.Partial("_MyOpeningTicket", Model.MyOpenningIssues)
        }
        else
        {
            <p>@Resources.Views_Home_Index_NoTicket</p>
        }
    </div>
</div>


<div class="panel feature">
    <div class="panel-heading text-info">@Resources.Views_Home_Index_Annoucements</div>
    <div class="panel-body">
        @Html.Partial("_Announcement")
    </div>
</div>