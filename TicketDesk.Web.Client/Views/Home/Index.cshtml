@model TicketDesk.Web.Client.Models.Home.HomeViewModel

@section title{ Services & Staffs Portal }

@section css
{
    @*<link rel="stylesheet" type="text/css" href="~/src/libs/datatables/datatables.min.css"/>*@
}

@section scripts
{
    @*<script type="text/javascript" src="~/src/libs/datatables/datatables.min.js"></script>*@

    <script>
        $(document).ready(function() {
            $('.header').on("click",
                function () {
                    //$(this).toggleClass('expand').nextUntil('tr.header').slideToggle(100);
                    var $this = $(this);
                    groupTicket = $this.attr('data-title');
                    var childRows = $('[data-group="' + groupTicket + '"]');
                    $this.toggleClass('expand');
                    childRows.find('td').slideToggle('fast');
                    //$this.toggleClass('expand').siblings('[data-collapse]').find('td').slideToggle('fast');
                });
            $("#itemperpage-select").on("change",
                function() {
                    var selectedValue = $(this).val();

                    window.location = "@Url.Action("Index", "Home", new {page = 1})" + "&itemPerPage=" + selectedValue;
                });
        });
        
    </script>
}

<div class="panel feature">
    <div class="panel-heading text-info">My openning issue</div>
    <div class="panel-body">
        @Html.Partial("_MyOpeningTicket", Model.MyOpenningIssues.TicketGroups)

        <ul class="pagination">
            @if (Model.MyOpenningIssues.CurrentPage == 1)
            {
                <li>
                    <a>Pre</a>
                </li>
            }
            else
            {
                <li><a href="@Url.Action("Index", "Home", new { page = (Model.MyOpenningIssues.CurrentPage - 1), itemPerPage = Model.MyOpenningIssues.ItemPerPage })">Pre</a></li>
            }
            @for (int i = 0; i < Model.MyOpenningIssues.TotalPage; i++)
            {
                var activeClass = "";
                if (Model.MyOpenningIssues.CurrentPage == (i + 1))
                {
                    activeClass = "active";
                }
                
                <li class="@activeClass"><a href="@Url.Action("Index", "Home", new { page = (i + 1), itemPerPage = Model.MyOpenningIssues.ItemPerPage })">@(i + 1)</a></li>
            }
            @if (Model.MyOpenningIssues.CurrentPage == Model.MyOpenningIssues.TotalPage)
            {
                <li>
                    <a>Next</a>
                </li>
            }
            else
            {
                <li><a href="@Url.Action("Index", "Home", new { page = (Model.MyOpenningIssues.CurrentPage + 1), itemPerPage = Model.MyOpenningIssues.ItemPerPage })">Next</a></li>
            }
        </ul>

        @Html.LabelForModel(Model.MyOpenningIssues.ItemPerPage)
        @Html.DropDownListFor(x => x.MyOpenningIssues.ItemPerPage, Model.MyOpenningIssues.ItemPerPageList, new { id = "itemperpage-select" })
        
        <p>Displaying @Model.MyOpenningIssues.FromItemIndex to @Model.MyOpenningIssues.ToItemIndex of @Model.MyOpenningIssues.TotalItem item(s)</p>

    </div>
</div>


<div class="panel feature">
    <div class="panel-heading text-info">Announcements</div>
    <div class="panel-body">
        @Html.Partial("_Announcement")
    </div>
</div>