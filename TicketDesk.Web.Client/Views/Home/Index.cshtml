@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Home.HomeViewModel

@section title{ @Resources.Common_App_Title }

@section css
{
    <link href="~/src/libs/jquery.DataTable/datatables.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/datetimepicker/moment.js"></script>

    <script src="~/src/libs/jquery.DataTable/datatables.min.js" type="text/javascript"></script>
    <script src="~/src/libs/jquery.DataTable/datetime.js" type="text/javascript"></script>
    <script src="~/src/libs/jquery.DataTable/dataTables.rowGroup.min.js" type="text/javascript"></script>

    <script src="~/src/js/admin/dataTableCommon.js"></script>

    <script type="text/javascript" src="~/src/js/home/read-announcement.js"></script>
    <script type="text/javascript" src="~/src/js/home/home.js"></script>
}

<div class="home-main">
    <div class="feature">
        <div class="panel-heading text-info">@Resources.Views_Home_Index_MyOpenningIssue</div>
        <div class="panel-body" id="my-opening-tickets" data-action="@Url.Action("MyOpeningTicket","Home")"></div>
    </div>
    <div class="feature">
        <div class="panel-heading text-info">
            <span>@Resources.Views_Home_Index_Announcements</span>
            <button class="btn btn-unread" type="button">Unread<span class="text-red"> (<span class="unread-announcements">@Model.UnreadAnnouncementQuatity</span>)</span></button>
        </div>
        <div class="panel-body">
            <div id="announcement-list">
            </div>
            <a class="btn btn-default btn-more" href="@Url.Action("MoreAnnouncement","Home")">@Resources.Views_Home_Announcement_More</a>
        </div>
    </div>
</div>