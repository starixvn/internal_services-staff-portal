@using TicketDesk.Localization.Client

@model TicketDesk.Web.Client.Models.Home.MoreAnnouncementViewModel

@section title{ Announcement }
@section css
{
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
    <link href="~/src/libs/jquery.DataTable/datatables.min.css" rel="stylesheet" />

}

@section scripts
{
    <script src="~/src/js/admin/dataTableCommon.js"></script>
    <script src="~/src/libs/jquery.DataTable/datatables.min.js" type="text/javascript"></script>
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.js"></script>
    <script src="~/src/js/home/read-announcement.js"></script>
    <script src="~/src/js/home/more-announcement.js"></script>
}

<div class="announcement-detail">
    <div class="form-content feature">

        <div class="title panel-heading">
            <a class="btn btn-back"><span class="icon-angle-left"></span>@Resources.Back</a>
            @Resources.Views_Home_Index_Announcements
        </div>

        <div class="content-announcement panel-body">

            @using (Html.BeginForm("ListAllAnnouncement", "Home", FormMethod.Post, new { @class = "form-inline filter" }))
            {
                <div class="form-group">
                    @Html.LabelFor(x => x.PublishedFrom, new { @class = "label-filter" })
                    <div class='input-group date'>
                        @Html.TextBoxFor(x => x.PublishedFrom, new { @class = "form-control datetimepicker", id = "from-date" })
                        <span class="icon-calendar"></span>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(x => x.PublishedTo, new { @class = "label-filter" })
                    <div class='input-group date'>
                        @Html.TextBoxFor(x => x.PublishedTo, new { @class = "form-control datetimepicker", id = "to-date" })
                        <span class="icon-calendar"></span>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(x => x.Type, new { @class = "label-filter" })
                    <div class='input-group date'>
                        @Html.EnumDropDownListFor(x => x.Type, @Resources.All, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    <input type="submit" value="@Resources.Views_Announcement_Submit" class="btn btn-submit" />
                </div>
            }

            <div id="announcement-list"></div>
        </div>
    </div>
</div>