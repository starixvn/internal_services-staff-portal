@using TicketDesk.Domain.Model
@using TicketDesk.Localization.Client

@model TicketDesk.Web.Client.Models.Home.MoreAnnouncementViewModel

@section title{ Announcement }
@section css
{
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
}
<div class="announcement-detail">
    <div class="form-content feature">
        <div class="title panel-heading">
            <a href="@Url.Action("Index","Home")" class="btn btn-back rippler rippler-default"><span class="icon-angle-left"></span>@Resources.Views_Announcement_BackToDashboard</a>
            @Resources.Views_Home_Index_Annoucements
        </div>
        <div class="content-announcement panel-body">
            <form class="form-inline filter" role="form">
                <div class="form-group">
                    <label>@Resources.Views_Announcement_From</label>
                    <div class='input-group date' id='from-date'>
                        <input type='text' class="form-control" />
                        <span class="input-group-addon">
                            <span class="icon-calendar"></span>
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label>@Resources.Views_Announcement_To</label>
                    <div class='input-group date' id='to-date'>
                        <input type='text' class="form-control" />
                        <span class="input-group-addon">
                            <span class="icon-calendar"></span>
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="@Resources.Views_Announcement_Submit" class="btn btn-primary" />
                </div>
            </form>
            <table class="table table-bordered tbl-announcement-detail">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th class="text-center">@Resources.Views_Announcement_Message</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var group in Model.AnnouncementGroups)
                    {
                        <tr class="header">
                            <td colspan="2">@group.Name</td>
                        </tr>

                        int index = -1;
                        foreach (var annoucement in group.Announcements)
                        {
                            index++;

                            bool isImportant = annoucement.Status == AnnouncementStatus.Important;
                            bool isEven = index % 2 == 1;

                            string announcementClass = "";
                            if (isImportant)
                            {
                                announcementClass += " error";
                            }
                            if (isEven)
                            {
                                announcementClass += " even";
                            }

                            <tr class="@announcementClass">
                                <td class="text-center">@(index + 1)</td>
                                <td>
                                    <span>@annoucement.PublishedDateTime.Value.ToString("g") @annoucement.Id</span><br>
                                    <span>@annoucement.Message</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#from-date').datetimepicker({
                format: 'DD/MM/YYYY'
            });
            $('#to-date').datetimepicker({
                useCurrent: false, //Important! See issue #1075
                format: 'DD/MM/YYYY'
            });
            $("#from-date").on("dp.change", function (e) {
                $('#to-date').data("DateTimePicker").minDate(e.date);
            });
            $("#to-date").on("dp.change", function (e) {
                $('#from-date').data("DateTimePicker").maxDate(e.date);
            });
        });
    </script>
}
