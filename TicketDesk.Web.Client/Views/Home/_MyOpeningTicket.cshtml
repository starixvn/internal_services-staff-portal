@model IList<TicketDesk.Web.Client.Models.Home.TicketGroup>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th class="text-center width-100">#</th>
            <th>Subject</th>
            <th class="text-center width-150">Created Date</th>
            <th class="text-center width-150">Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticketGroup in Model)
        {
            <tr class="header">
                <td colspan="4"><span class="sign"></span> @ticketGroup.Name <span class="number-ticket">(@ticketGroup.Tickets.Count())</span></td>
            </tr>

            foreach (var ticket in ticketGroup.Tickets)
            {
                <tr class="child-@ticketGroup.Name">
                    <td class="text-center">
                        <a href="@Url.Action("Index","TicketCenter", new {id = ticket.TicketId})">@ticket.TicketId</a>
                    </td>
                    <td>@ticket.Title</td>
                    <td class="text-center">@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                    <td class="text-center">@ticket.TicketStatus</td>
                </tr>
            }
        }
    </tbody>

</table>
