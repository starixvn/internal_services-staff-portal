@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Home.MyOpenningTicketsViewModel

@if (Model.TicketGroups.Any())
{
    <table class="table table-bordered table-hover" id="home-myopenning-tickets">
        <thead>
            <tr>
                <th class="text-center width-80">#</th>
                <th>@Resources.Domain_Model_Ticket_Title</th>
                <th class="text-center width-150">@Resources.Domain_Model_Ticket_CreatedDate</th>
                <th class="text-center width-150">@Resources.Domain_Model_Ticket_Status</th>
                <th>group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticketGroup in Model.TicketGroups)
            {
                @*<tr class="header expand" data-title="@ticketGroup.Name">
                    <td colspan="4"><span class="sign expanded"></span> @ticketGroup.Name <span class="number-ticket">(@ticketGroup.TotalItems)</span></td>
                </tr>*@

                int index = -1;

                foreach (var ticket in ticketGroup.Tickets)
                {
                    index++;
                    string evenClass = "";
                    if (index % 2 == 1)
                    {
                        evenClass = "even";
                    }

                    <tr class="@evenClass" data-group="@ticketGroup.Name">
                        <td class="text-center">
                            <a href="@Url.Action("TicketDetails","TicketList", new {ticketId = ticket.TicketId})" class="id-ticket">@ticket.TicketId</a>
                        </td>
                        <td>@ticket.Title</td>
                        <td class="text-center">@ticket.CreatedDate.ToString("MMM dd, yyyy")</td>
                        @{
                            var statusClass = ticket.TicketStatus.ToString().ToLowerInvariant();
                        }
                        <td class="text-center"><span class="@statusClass">@ticket.TicketStatus</span></td>
                        <td>@Html.Raw(ticketGroup.Name + "(" + ticketGroup.TotalItems + ")")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else
{
    <p>@Resources.Views_Home_Index_NoTicket</p>
}