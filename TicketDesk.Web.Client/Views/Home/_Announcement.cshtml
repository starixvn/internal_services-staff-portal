@using TicketDesk.Domain.Model
@using TicketDesk.Localization.Client
@model IList<TicketDesk.Web.Client.Models.Home.AnnouncementGroup>

<table class="table table-bordered tbl-announcement">
    <tbody>
        @foreach (var group in Model)
        {
            <tr class="header">
                <td colspan="2">@group.Name</td>
            </tr>

            int index = -1;
            foreach (var announcement in group.Announcements)
            {
                index++;
                
                bool isImportant = announcement.Status == AnnouncementStatus.Important;
                bool isEven = index % 2 == 1;

                string announcementClass = "";
                if (isImportant)
                {
                    announcementClass += " error";
                }
                if (isEven)
                {
                    announcementClass += " even";
                }

                <tr class="@announcementClass">
                    <td class="width-150"><span class="sign"></span>@announcement.PublishedDateTime.Value.ToShortTimeString()</td>
                    <td class="show-text">@announcement.Message</td>
                </tr>
            }
        }
    </tbody>
</table>
<a class="btn btn-default btn-more rippler rippler-default" href="@Url.Action("MoreAnnouncement","Home")">@Resources.Views_Home_Announcement_More</a>