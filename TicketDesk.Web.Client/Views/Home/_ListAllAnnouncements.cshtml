@using TicketDesk.Localization.Client
@using TicketDesk.Core.Enumerations
@using TicketDesk.Domain.Model
@model IList<Announcement>

<table class="table table-bordered tbl-announcement-detail tbl-announcement">
    <thead>
        <tr>
            <th class="text-center id">#</th>
            <th class="text-center">@Resources.Views_Announcement_Message</th>
        </tr>
    </thead>

    <tbody>
            @{
            int index = 0;
            foreach (var announcement in Model)
            {
                bool isImportant = announcement.Type == AnnouncementType.Important;
                bool isEven = index % 2 == 1;

                string announcementClass = "";
                int unreadId = !announcement.IsRead ? announcement.Id : 0;

                if (isImportant)
                {
                    announcementClass += " msg-important";
                }
                if (isEven)
                {
                    announcementClass += " even";
                }

                if (!announcement.IsRead)
                {
                    announcementClass += " unread";
                }

                <tr class="@announcementClass" data-id="@unreadId" data-href="@Url.Action("SaveAndCountTotalUnreadAnnouncement", "NapUserSetting", new { id = unreadId})">
                    <td class="text-center">@(index + 1)</td>
                    <td>
                        <span>@announcement.PublishedDateTime.Value.ToString("g") @announcement.Id</span><br>
                        <span>@announcement.Message</span>
                    </td>
                </tr>

                index++;
            }
        }
        
    </tbody>
</table>