@using TicketDesk.Domain.Model
@using TicketDesk.Localization.Client
@using TicketDesk.Core.Enumerations
@using TicketDesk.Localization.Views.Ticket
@model SingleTicketViewModel

@{
    ViewBag.Title = Resources.TicketDetails;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ticket-list">
    <div class="form-content feature">
        <div class="title panel-heading">
            <a href="/" class="btn btn-back"><span class="icon-angle-left"></span>@Resources.BackToTicketList</a>
            @{
                TicketCategoryTypes type = (TicketCategoryTypes)Model.Ticket.CategoryId;
                string header = string.Format("{0}{1}{2}", Model.Ticket.TicketId, " - ", type.ToString());
            }
            <span class="id">@header</span>
        </div>
        <div class="panel-body">
            <div class="detail-item">
                <span class="item-title">@Html.DisplayNameFor(x => x.Ticket.Title): </span>
                <span class="item-content">@Model.Ticket.Title</span>
            </div>

            <div class="detail-item">
                <span class="item-title">@Resources.ShopName: </span>
                <span class="item-content">@Model.ShopName</span>
            </div>

            <div class="detail-item">
                <span class="item-title">@Resources.Domain_Model_Ticket_Status: </span>
               
                <span class="item-content">@Model.Ticket.TicketStatus</span>
            </div>

            <div class="detail-item">
                <span class="item-title">@Resources.Domain_Model_Ticket_CreatedDate: </span>
                <span class="item-content">@Model.Ticket.CreatedDate</span>
            </div>

            @foreach (var customFieldValue in Model.CustomFieldValues)
            {
                <div class="detail-item">
                    <span class="item-title">@customFieldValue.CustomField.Name: </span>

                    @if (string.IsNullOrEmpty(customFieldValue.Value))
                    {
                        <span class="item-content">[NO VALUES]</span>
                    }
                    else
                    {
                        <span class="item-content">@customFieldValue.Value</span>
                    }
                </div>
            }

            <div class="detail-item">
                <span class="item-title">@Index.Files</span>
                <ul class="list-unstyled list-inline">
                    @foreach (var file in Model.Attachments)
                    {
                        <li>
                            <a class="file-attachments" href="@Url.Action("GetFile", "File", new {Id = Model.Ticket.TicketId, FileName = file.Name})" target="_blank"><i class="fa fa-file fa-align-left"></i> @file.Name</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
