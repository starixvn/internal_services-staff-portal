@using TicketDesk.Localization.Client
@using TicketDesk.Domain.Extensions
@model TicketDesk.Web.Client.Models.TicketList.TicketListViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section title
{
    @Resources.TicketList
}

@section scripts
{
    <script src="~/src/js/pagination.js" type="text/javascript"></script>
}

<div class="ticket-list">
    <div class="form-content feature">
        <div class="title panel-heading">
            @Resources.TicketList
        </div>
        <div class="panel-body">
            @using (Html.BeginForm("Index", "TicketList", FormMethod.Get, new { @class = "form-inline filter" }))
            {
                <div class="form-group">
                    @Html.LabelFor(x => x.Status)
                    <div class='input-group dropdown'>
                        @Html.EnumDropDownListFor(x => x.Status, "All", new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    <input type="submit" value="@Resources.Views_Announcement_Submit" class="btn btn-submit" />
                </div>
            }
            <table class="table table-bordered table-hover" id="ticket-list-table">
                <thead>
                    <tr>
                        <th class="text-center width-80">#</th>
                        <th class="text-center width-80">@Resources.ID</th>
                        <th>@Resources.Domain_Model_Ticket_Title</th>
                        <th class="width-150">@Resources.TicketCategory</th>
                        <th>@Resources.ShopName</th>
                        <th class="text-center width-230">@Resources.Domain_Model_Ticket_CreatedDate</th>
                        <th class="text-center width-120">@Resources.Domain_Model_Ticket_Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tickets.Count() > 0)
                    {
                        var index = 0;
                        foreach (var ticket in Model.Tickets)
                        {
                            var evenClass = index % 2 != 0 ? "even" : string.Empty;
                            index++;

                            <tr class="@evenClass">
                                <td class="text-center">@index</td>
                                <td class="text-center">
                                    <a class="id-ticket" href="@Url.Action("TicketDetails", "TicketList", new { ticketId = ticket.Id })">@ticket.Id</a>
                                </td>
                                <td>@ticket.Subject</td>
                                <td>@ticket.TicketType.GetDisplayName()</td>
                                <td>@ticket.ShopName</td>
                                <td>@ticket.CreatedDate</td>
                                @{
                                    var statusClass = ticket.Status.ToString().ToLowerInvariant();
                                }
                                <td class="text-center">
                                    <span class="@statusClass">@ticket.Status.GetDisplayName()</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                @Resources.TableNoData
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @Html.Partial("_Pagination", Model)
        </div>
    </div>
</div>