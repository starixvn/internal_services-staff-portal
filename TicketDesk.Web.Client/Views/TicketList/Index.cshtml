@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.TicketList.TicketListViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section title
{
    @Resources.TicketList
}
@section css
{
    <link href="~/src/libs/jquery.DataTable/datatables.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/js/admin/dataTableCommon.js"></script>
    <script src="~/src/libs/jquery.DataTable/datatables.min.js" type="text/javascript"></script>
    <script src="~/src/js/ticket-list/ticket-list.js" type="text/javascript"></script>
}

<div class="ticket-list">
    <div class="form-content feature">
        <div class="title panel-heading">
            @Resources.TicketList
        </div>
        <div class="panel-body">
            @using (Html.BeginForm("TicketList", "TicketList", FormMethod.Post, new { @class = "form-inline filter" }))
            {
                <div class="form-group">
                    @Html.LabelFor(x => x.Status)
                    <div class='input-group dropdown'>
                        @Html.EnumDropDownListFor(x => x.Status, @Resources.All, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(x => x.TicketType)
                    <div class='input-group dropdown'>
                        @Html.EnumDropDownListFor(x => x.TicketType, @Resources.All, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    <input type="submit" value="@Resources.Views_Announcement_Submit" class="btn btn-submit" />
                </div>
            }

            <div id="ticket-list">
            </div>
        </div>
    </div>
</div>