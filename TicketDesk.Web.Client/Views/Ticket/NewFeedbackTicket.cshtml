@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers

@model TicketDesk.Web.Client.Models.Ticket.NewFeedbackTicketViewModel

@section title { @New.Title }

@section scripts
{
    @Styles.Render("~/content/editor")
    @Styles.Render("~/content/select2")
    @*@Styles.Render("~/content/summernote")*@

    @Scripts.Render("~/bundles/select2")
    @Scripts.Render("~/bundles/select2_locale_" + CultureHelper.GetCurrentCulture())
    @*@Scripts.Render("~/bundles/markdown")
    @Scripts.Render("~/bundles/summernote")
    @Scripts.Render("~/bundles/summernote_locale_" + CultureHelper.GetCurrentCulture())*@
    @Scripts.Render("~/bundles/editor")

    <script type="text/javascript">
        $(document).ready(function() {
            //var isHtmlString = @(Model.Ticket.IsHtml ? "true" : "false");

            $.ajaxSetup({ cache: false });

            var uploaderConfig = {
                dropzoneUploadUrl: '@Url.Action("Upload", "File")',
                getAttachmentsUrl: '@Url.Action("GetAttachmentsInfo", "File")',
                deleteFileUrl: '@Url.Action("Delete", "File")',
                defaultThumbnailUrl: '@Url.Content("~/content/images/general-file.png")',
                ticketId: null
            };

            var tagsConfig = {
                tagAutoCompleteUrl: '@Url.Action("TagList", "AutoComplete")'
            };

            //var detailsConfig = {
            //    isHtml: isHtmlString
            //};

            window.ticketTags.activate(tagsConfig);
            //window.ticketDetails.activate(detailsConfig);
            window.ticketFileUploader.activate(uploaderConfig);
        });
    </script>
}

@using (Html.BeginForm("Feedback", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @Html.HiddenFor(model => model.Ticket.Title)
    @Html.HiddenFor(model => model.Ticket.TicketType)
    @Html.HiddenFor(model => model.Ticket.Category)
    @Html.HiddenFor(model => model.Ticket.Priority)
    @Html.HiddenFor(model => model.Ticket.Details)

    <div class="form-content feedback-form">
        <div class="title">FEEDBACK FORM</div>
        <div class="key border">Feedback by</div>
        <div class="value span-3 border">
            <div class="radio-group">
                @Html.HiddenFor(x => x.FeedbackBy.CustomFieldId, new { Value = Model.FeedbackBy.CustomField.Id })
                @foreach (string feedbackByValue in Model.FeedbackByValues)
                {
                    var rdId = "rd-" + feedbackByValue.Replace(' ', '_');

                    <p>
                        @Html.RadioButtonFor(x => x.FeedbackBy.Value, feedbackByValue, new { id = rdId })
                        <label for="@rdId">@feedbackByValue</label>
                    </p>
                }
            </div>
        </div>
        <div class="item-list item">
            @Html.CustomFieldLabelFor(x => x.Subject, new { @class = "key fullwidth border" })
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.Subject)
            </div>
        </div>
        <div class="item-list item">
            @Html.CustomFieldLabelFor(x => x.CustomerName, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.CustomerName)
            </div>
        </div>
        <div class="item-list item">
            @Html.CustomFieldLabelFor(x => x.Feedback, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.Feedback)
            </div>
        </div>
        <div class="attach-file">
            <div class="key border">Attach files*:</div>
            <div class="value span-3 border">
                @Html.Partial("_TicketAttachedFiles", Model.Ticket)
            </div>
            <div class="fullwidth bold border"><span class="highlight">*</span>Max number of attachments: <span class="highlight">20 Files</span> | Max total size of attachments: <span class="highlight">32 MB</span> | Allowed file types: <span class="highlight">jpeg,jpg,pdf</span></div>
        </div>
    </div>
    <input type="submit" class="btn btn-send" value="Send" />
    @*<div class="panel panel-info">
            <div class="panel-heading">
                <h2 class="panel-title">@New.Header</h2>
