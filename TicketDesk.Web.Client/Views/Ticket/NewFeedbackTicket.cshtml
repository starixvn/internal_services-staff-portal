@using TicketDesk.Localization.Client
@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers

@model TicketDesk.Web.Client.Models.Ticket.NewFeedbackTicketViewModel

@section title { @New.Title }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
    <link href="~/src/css/custom-dropzone.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/dropzone/dropzone.min.js"></script>
    <script src="~/src/js/ticket-dropzone.js"></script>

    <script src="~/src/js/formhandler.js"></script>
}

@Html.Partial("_NotificationModal")

@using (Html.BeginForm("NewFeedbackTicket", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal ticket-form filechange", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @Html.HiddenFor(model => model.TempId)

    <div class="form-content feedback-form">
        <div class="title">@Resources.Views_Ticket_NewFeedbackTicket_Title</div>

        <div class="item-list item shop-item">
            <div class="key fullwidth">
                @Html.LabelFor(x => x.Ticket.ShopId)
            </div>

            <div class="fullwidth">
                <div class="fullwidth no-border custom-dropdown">
                    @Html.DropDownListFor(x => x.Ticket.ShopId, @Model.Ticket.ShopList, new { @class = "shop-selector select2-searchable" })
                </div>
            </div>
        </div>

        <div class="height-auto">
            @Html.CustomFieldLabelFor(x => x.FeedbackBy, new { @class = "key border label-item" })
            <div class="value span-3 border">
                <div class="radio-group">
                    @Html.HiddenFor(x => x.FeedbackBy.CustomFieldId, new { Value = Model.FeedbackBy.CustomField.Id })
                    @Html.HiddenFor(model => model.SelectedFeedbackByValue, new { @class = "required-radio-value" })

                    @foreach (string feedbackByValue in Model.FeedbackByValues)
                    {
                        var rdId = "rd-" + feedbackByValue.Replace(' ', '_');

                        <p>
                            @Html.RadioButtonFor(x => x.FeedbackBy.Value, feedbackByValue, new { id = rdId, @class = "required-radio" })
                            <label for="@rdId">@feedbackByValue</label>
                        </p>
                    }
                </div>
                @Html.ValidationMessageFor(x => x.SelectedFeedbackByValue)
            </div>
        </div>

        <div class="item-list item">
            <div class="key fullwidth border">
                @Html.RequiredLabelFor(x => x.Ticket.Title, new { @class = "" })
            </div>
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.Ticket.Title)
                @Html.ValidationMessageFor(x => x.Ticket.Title)
            </div>
        </div>
        <div class="item-list item">
            <div class="key fullwidth">
                @Html.CustomFieldLabelFor(x => x.CustomerName, new { @class = "" })
            </div>

            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.CustomerName)
                @Html.ValidationMessageFor(x => x.CustomerName.Value)
            </div>
        </div>
        <div class="item-list item">
            <div class="key fullwidth">
                @Html.CustomFieldLabelFor(x => x.Feedback, isIncludeMaxlength: true)
            </div>
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.Feedback, new { @class = "description" })
                @Html.ValidationMessageFor(x => x.Feedback.Value)
            </div>
        </div>
        @Html.Partial("_DropzoneView", Model)

        @if (Model.AllowToChooseRecipient)
        {
            <div class="item-list item shop-item">
                <div class="key fullwidth">
                    @Html.LabelFor(x => x.Ticket.AdditionalMail)
                </div>

                <div class="fullwidth">
                    <div class="fullwidth no-border custom-dropdown">
                        @Html.TextBoxFor(x => x.Ticket.AdditionalMail)
                    </div>
                </div>
            </div>
        }
    </div>
    <input type="submit" class="btn btn-primary btn-send" value="@Resources.Common_Form_Send" />
}