@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers

@model TicketDesk.Web.Client.Models.Ticket.NewFeedbackTicketViewModel

@section title { @New.Title }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
    <link href="~/src/css/custom-dropzone.css" rel="stylesheet" />
}

@section scripts
{
    @Html.Partial("_DropzoneScripts", Model)
}

@using (Html.BeginForm("NewFeedbackTicket", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @*@Html.HiddenFor(model => model.Ticket.Title)*@
    @Html.HiddenFor(model => model.Ticket.TicketType)
    @Html.HiddenFor(model => model.Ticket.Category)
    @Html.HiddenFor(model => model.Ticket.Priority)
    @Html.HiddenFor(model => model.Ticket.Details)
    @Html.HiddenFor(model => model.TempId)

    <div class="form-content feedback-form">
        <div class="title">FEEDBACK FORM</div>
        <div class="key border">Feedback by</div>
        <div class="value span-3 border">
            <div class="radio-group">
                @Html.HiddenFor(x => x.FeedbackBy.CustomFieldId, new { Value = Model.FeedbackBy.CustomField.Id })
                @foreach (string feedbackByValue in Model.FeedbackByValues)
                {
                    var rdId = "rd-" + feedbackByValue.Replace(' ', '_');

                    <p>
                        @Html.RadioButtonFor(x => x.FeedbackBy.Value, feedbackByValue, new { id = rdId })
                        <label for="@rdId">@feedbackByValue</label>
                    </p>
                }
            </div>
        </div>
        <div class="item-list item">
            @Html.LabelFor(x => x.Ticket.Title, new { @class = "key fullwidth border" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.Ticket.Title)
            </div>
        </div>
        <div class="item-list item">
            @Html.CustomFieldLabelFor(x => x.CustomerName, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.CustomerName)
            </div>
        </div>
        <div class="item-list item">
            @Html.CustomFieldLabelFor(x => x.Feedback, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.Feedback)
            </div>
        </div>
        @Html.Partial("_DropzoneView", Model)
    </div>
    <input type="submit" class="btn btn-primary btn-send" value="Send" />
}