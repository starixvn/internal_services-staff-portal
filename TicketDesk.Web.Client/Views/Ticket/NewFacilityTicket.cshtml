@using System.Configuration
@using TicketDesk.Domain.Model
@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers
@model TicketDesk.Web.Client.Models.Ticket.NewFacilityTicketViewModel

@section title { @New.Title }

@section scripts
{
    @Styles.Render("~/content/editor")
    @Styles.Render("~/content/select2")
    @Styles.Render("~/content/summernote")

    @Scripts.Render("~/bundles/select2")
    @Scripts.Render("~/bundles/select2_locale_" + CultureHelper.GetCurrentCulture())
    @Scripts.Render("~/bundles/markdown")
    @Scripts.Render("~/bundles/summernote")
    @Scripts.Render("~/bundles/summernote_locale_" + CultureHelper.GetCurrentCulture())
    @Scripts.Render("~/bundles/editor")

    <script type="text/javascript">
        var isHtmlString = @(Model.Ticket.IsHtml ? "true" : "false");
        (function () {
            $.ajaxSetup({ cache: false });
            var uploaderConfig = {
                dropzoneUploadUrl: '@Url.Action("Upload", "File")',
                getAttachmentsUrl: '@Url.Action("GetAttachmentsInfo", "File")',
                deleteFileUrl: '@Url.Action("Delete", "File")',
                defaultThumbnailUrl: '@Url.Content("~/content/images/general-file.png")',
                ticketId: null
            };
            var tagsConfig = {
                tagAutoCompleteUrl: '@Url.Action("TagList", "AutoComplete")'
            };
            var detailsConfig = {
                isHtml: isHtmlString
            };
            window.ticketTags.activate(tagsConfig);
            window.ticketDetails.activate(detailsConfig);
            window.ticketFileUploader.activate(uploaderConfig);
        })();
    </script>

    <script>
        function GenerateGuid() {
            function s4() {
                return Math.floor((1 + Math.random()) * 0x10000)
                    .toString(16)
                    .substring(1);
            }

            return s4() + s4() + "-" + s4() + "-" + s4() + "-" + s4() + "-" + s4() + s4() + s4();
        }

        function AssignAddMoreButton() {
            $(".add-more-button").click(function (event) {
                event.preventDefault();
                var id = "#" + $(this).data("class");
                var clone = $(id).children().last().clone();
                var guid = clone.children().first().val();
                var regex = new RegExp(guid, "g");
                var newHtml = clone.html(function (i, oldHtml) {
                    return oldHtml.replace(regex, GenerateGuid());
                });
                $(id).append(newHtml);

                $(".remove-button").show();
                $(".remove-button:first").hide();
            });
        }

        function AssignRemoveButton() {
            $(".remove-button:first").hide();
            $("body").on("click",".remove-button", function() {
                $(this).parent().remove();
            });
        }

        $(document).ready(function() {
            AssignAddMoreButton();
            AssignRemoveButton();
        });
    </script>
}
<main>
    <div class="container">
        <div class="col-lg-10 col-lg-offset-1 col-md-12">
            @using (Html.BeginForm("New", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h2 class="panel-title">@New.Header</h2>
                    </div>
                    <div class="panel-body ">

                        <div class="panel panel-info">
                            <div class="panel-heading">General</div>
                            <div class="panel-body">
                                @Html.AntiForgeryToken()

                                @Html.ValidationSummary(true, New.UnableCreateTicket, new { @class = "alert alert-danger" })

                                @Html.HiddenFor(model => model.Ticket.TicketId)
                                @Html.HiddenFor(model => model.Ticket.IsHtml)
                                <input type="hidden" name="tempId" value="@ViewBag.TempId" />

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Ticket.Category, new { @class = "col-md-2 col-sm-1 control-label" })
                                    <div class="col-md-8 col-sm-11">
                                        @Html.DropDownListFor(model => model.Ticket.Category, Model.Ticket.GetCategoryList(), new { @class = "form-control input-sm", tabindex = 1 })
                                        @Html.ValidationMessageFor(model => model.Ticket.Category, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Ticket.Title, new { @class = "col-md-2 col-sm-1 control-label focus" })
                                    <div class="col-md-8 col-sm-11">
                                        @Html.TextBoxFor(model => model.Ticket.Title, new { @class = "form-control input-sm", placeholder = New.TicketTitle_Placeholder, tabindex = 1, autofocus = string.Empty })
                                        @Html.ValidationMessageFor(model => model.Ticket.Title, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @if (Model.Ticket.AllowEditTags())
                                    {
                                        @Html.LabelFor(model => model.Ticket.TagList, new { @class = "col-md-2 col-sm-1 control-label focus" })
                                        <div class="col-md-5 col-sm-5">
                                            @Html.TextBoxFor(m => m.Ticket.TagList, new { id = "ticketTags", @class = "form-control input-sm", tabindex = 1 })
                                        </div>
                                    }
                                </div>

                                <div class="form-group">
                                    <div class="col-md-2 col-md-offset-2 col-sm-3 col-sm-offset-1">
                                        <label class="checkbox-inline" for="affectsCustomer">
                                            <input class="" type="checkbox" name="affectsCustomer" id="affectsCustomer" value="true" tabindex="5" />
                                            @New.AffectsCustomer
                                        </label>
                                    </div>
                                </div>

                                @if (Model.Ticket.IsHtml)
                                {
                                    <div class="form-group">
                                        <label class="col-md-2 col-sm-1 control-label text-right" for="summernote">@New.Details</label>
                                        <div class="col-md-8 col-sm-11">
                                            <textarea id="wmd-input-ticketDetails" name="Details" data-val-required="" data-val="true">@Model.Ticket.Details</textarea>
                                            @Html.ValidationMessageFor(model => model.Ticket.Details, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-group">
                                        <label class="col-md-2 col-sm-1 control-label text-right" for="wmd-input-ticketDetails">@New.Details</label>
                                        <div class="col-md-8 col-sm-11 wmd-panel">
                                            <div class="tabbable tabs-below">
                                                <div class="tab-content">
                                                    <div class="tab-pane fade in active" id="tab1">
                                                        <div id="wmd-button-bar-ticketDetails" class="" style="display: inline-block"></div>
                                                        @Html.TextAreaFor(model => model.Ticket.Details, new { id = "wmd-input-ticketDetails", @class = "wmd-input form-control", data_val_required = "", data_val = "true", cols = "92", rows = "15", style = "height:200px", tabindex = 7 })

                                                    </div>
                                                    <div class="tab-pane fade" id="tab2">
                                                        <div class="row" style="min-height: 35px;"></div>

                                                        <div id="wmd-preview-ticketDetails" class="wmd-panel wmd-preview form-control">

                                                        </div>
                                                    </div>
                                                </div>
                                                <ul class="nav nav-tabs navbar-right">
                                                    <li class="active"><a href="#tab1" data-toggle="tab"><i class="fa fa-edit"></i>&nbsp;@New.EditOption</a></li>
                                                    <li><a href="#tab2" data-toggle="tab"><i class="fa fa-eye"></i>&nbsp;@New.PreviewOption</a></li>
                                                </ul>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.Ticket.Details, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="panel panel-info">
                            <div class="panel-heading">Specialization</div>
                            <div class="panel-body">
                                @*<div class="form-group">
                                        @Html.LabelFor(model => model.Ticket.TicketType, new { @class = "col-md-2 col-sm-1 control-label" })
                                        <div class="col-md-2 col-sm-3">
                                            @Html.ValidationMessageFor(model => model.Ticket.TicketType, "", new { @class = "text-danger" })
                                        </div>

                                        @if (Model.Ticket.AllowEditPriorityList())
                                        {
                                            @Html.LabelFor(model => model.Ticket.Priority, new { @class = "col-md-1 col-sm-1 control-label" })
                                            <div class="col-md-2 col-sm-3">
                                                @Html.DropDownListFor(model => model.Ticket.Priority, Model.Ticket.GetPriorityList(), new { @class = "form-control input-sm", tabindex = 4 })
                                                @Html.ValidationMessageFor(model => model.Ticket.Priority, "", new { @class = "text-danger" })
                                            </div>
                                        }
                                    </div>*@

                                @*<div class="form-group">
                                        @if (Model.Ticket.AllowSetOwner())
                                        {
                                            @Html.LabelFor(model => model.Ticket.Owner, new { @class = "col-md-2 col-sm-1 control-label" })
                                            <div class="col-md-3 col-sm-5">
                                                @Html.DropDownListFor(model => model.Ticket.Owner, Model.Ticket.GetOwnersList(), new { @class = "form-control input-sm", tabindex = 8 })
                                                @Html.ValidationMessageFor(model => model.Ticket.Owner, "", new { @class = "text-danger" })
                                            </div>
                                        }
                                        @if (Model.Ticket.AllowSetAssigned())
                                        {
                                            @Html.LabelFor(model => model.Ticket.AssignedTo, new { @class = "col-md-2 col-sm-2 control-label" })
                                            <div class="col-md-3 col-sm-4">
                                                @Html.DropDownListFor(model => model.Ticket.AssignedTo, Model.Ticket.GetAssignedToList(), new { @class = "form-control input-sm", tabindex = 9 })
                                                @Html.ValidationMessageFor(model => model.Ticket.AssignedTo, "", new { @class = "text-danger" })
                                            </div>
                                        }
                                    </div>*@

                                <div class="form-group">
                                    @Html.CustomFieldLabelFor(Model.RequestType, new { @class = "col-md-2 col-sm-1 control-label" })
                                    <div class="col-md-8 col-sm-11">
                                        @Html.CustomFieldFor(Model.RequestType, new { @class = "form-control input-sm" })
                                    </div>
                                </div>

                                <div class="panel panel-info">
                                    <div class="panel-heading">Items</div>
                                    <div id="item-section" class="panel-body form-group">
                                        @for (int i = 0; i < Model.Items.Count; i++)
                                        {
                                            var guid = Guid.NewGuid().ToString();

                                            <div>
                                                @Html.CustomFieldIndex("Items", guid)
                                                @Html.CustomFieldLabelWithGuidIndexFor(Model.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "col-md-2 col-sm-1 control-label" })
                                                @Html.CustomFieldWithGuidIndexFor(Model.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "form-control input-sm" })

                                                @Html.CustomFieldLabelWithGuidIndexFor(Model.Items.ElementAt(i).Reason, guid, "Items", new { @class = "col-md-2 col-sm-1 control-label" })
                                                @Html.CustomFieldWithGuidIndexFor(Model.Items.ElementAt(i).Reason, guid, "Items", new { @class = "form-control input-sm" })

                                                <button class="btn btn-danger remove-button">Remove</button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <button class="btn btn-default add-more-button" data-class="item-section">Add more</button>
                            </div>
                        </div>

                        <div class="panel panel-info">
                            <div class="panel-heading">Attached Files</div>
                            <div class="panel-body">
                                <div class="form-group">
                                    <label class="col-md-2 col-sm-1 control-label">@New.Files</label>
                                    <div class="col-md-8 col-sm-11">
                                        @{
                                            var demoMode = ConfigurationManager.AppSettings["ticketdesk:DemoModeEnabled"] ?? "false";
                                            if (demoMode.Equals("true", StringComparison.InvariantCultureIgnoreCase))
                                            {
                                                <div class="alert alert-warning">
                                                    @Html.Raw(New.Attachment_Demo_Alert)
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="dropzone" style="min-height: 40px;" id="attachmentsDropZone">
                                                    <div class="dz-message" data-dz-message><i class="fa fa-download "></i> @New.Attachment_Instructions</div>
                                                    <div class="dropzone-previews" id="dz-preview"></div>
                                                </div>
                                            }}
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="">
                            <button type="submit" class="btn btn-success" tabindex="10">@New.SaveOption</button>&nbsp;&nbsp;
                            @Html.ActionLink(New.BackOption, "Index")
                        </div>
                    </div>
                </div>
                                            }
        </div>
    </div>
</main>