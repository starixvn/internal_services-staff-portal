@using TicketDesk.Localization.Client
@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers

@model TicketDesk.Web.Client.Models.Ticket.NewFacilityTicketViewModel

@section title { @New.Title }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
    <link href="~/src/css/custom-dropzone.css" rel="stylesheet" />
}

@section scripts
{
    @Html.Partial("_DropzoneScripts", Model)

    <script src="~/src/js/formhandler.js"></script>

    <script>
        function ResetFormValidator() {
            $(".ticket-form").removeData('validator');
            $(".ticket-form").removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse(".ticket-form");
            CheckFormAndTurnSubmitButton("ticket-form");
        }

        function GenerateGuid() {
            function s4() {
                return Math.floor((1 + Math.random()) * 0x10000)
                    .toString(16)
                    .substring(1);
            }

            return s4() + s4() + "-" + s4() + "-" + s4() + "-" + s4() + "-" + s4() + s4() + s4();
        }

        function AssignAddMoreButton() {
            $(".btn-add").click(function (event) {
                $("select").select2('destroy');
                event.preventDefault();
                var id = "#" + $(this).data("class");
                var clone = $(id).children().last().clone();
                clone.find(".countdown-character").text(5000);
                var guid = clone.children().first().val();
                var regex = new RegExp(guid, "g");
                var newHtml = clone.html(function (i, oldHtml) {
                    return oldHtml.replace(regex, GenerateGuid());
                });

                $(id).append(newHtml);

                ResetFormValidator();

                $(".btn-delete-item").show();
                $(".btn-delete-item:first").hide();

                $(".ticket-form").trigger("change");

                var last = $(id).children().last();
                if ($(last).hasClass("even")) {
                    $(last).removeClass("even");
                } else {
                    $(last).addClass("even");
                }
                if ($("select").length) {
                    $("select").select2({
                        minimumResultsForSearch: Infinity
                    });
                }
            });

           
        }

        function AssignRemoveButton() {
            $(".btn-delete-item:first").hide();
            $("body").on("click",
                ".btn-delete-item",
                function () {
                    $(this).parent().parent().remove();
                    ResetFormValidator();

                    $(".ticket-form").trigger("change");
                });
        }

        $(document).ready(function () {
            AssignAddMoreButton();
            AssignRemoveButton();
        });
    </script>

    <script>
        function ToTitleCase(str) {
            return str.toLowerCase().split(' ').map(function (word) {
                return word.replace(word[0], word[0].toUpperCase());
            }).join(' ');
        }

        function GetTitle(baseTitle) {
            var values = $(".ticket-form").serializeArray();

            var requestTypeValue = "";
            for (var i = 0; i < values.length; i++) {
                if (values[i].name === "RequestType.Value") {
                    requestTypeValue = values[i].value;
                    break;
                }
            }

            var itemNames = "";
            for (var j = 0; j < values.length; j++) {
                if (values[j].name.indexOf("ItemName.Value") !== -1) {
                    if (itemNames === "") {
                        itemNames = values[j].value;
                    } else {
                        itemNames = itemNames + "...";
                        break;
                    }
                }
            }

            return "[" + baseTitle + "] - " + requestTypeValue + " " + itemNames;
        }

        $(document).ready(function () {
            InitFormHandler("ticket-form", false);

            var title = ToTitleCase("@Html.Raw(Resources.Views_Ticket_NewFacilityTicket_FormTitle)");

            // Default title for a ticket
            $(".ticket-title").val("[" + title + "]");

            $(".ticket-form").on("change",
                function () {
                    $(".ticket-title").val(GetTitle(title));
                });

            //$("#title_prefix, #title_custome").on("input",
            //    function() {
            //        $("#ticket-title").val($("#title_prefix").val() + " - " + $("#title_custome").val());
            //    });
            $('.subject input[type="text"]').keypress(function () {
                var value = ($(this).val().length + 1) * 8;
                $(this).css('width', value + 'px');
            });
        });
    </script>
}

@Html.Partial("_NotificationModal")

@using (Html.BeginForm("NewFacilityTicket", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal ticket-form filechange", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @Html.HiddenFor(model => model.TempId)

    <div class="form-content facility-form">
        <div class="title">@Resources.Views_Ticket_NewFacilityTicket_Title</div>
        <div class="item-list height-auto">
            @Html.RequiredLabelFor(x => x.Ticket.Title, new { @class = "key border label-item" })
            <div class="value span-3 border subject">
                @Html.ValidationMessageFor(x => x.Ticket.Title)
                @Html.TextBoxFor(model => model.Ticket.Title, new { @class = "ticket-title", @readonly = "readonly" })
            </div>
        </div>

        <div class="height-auto">
            @Html.CustomFieldLabelFor(x => x.RequestType, new { @class = "key border label-item" })
            <div class="value span-3 border">
                <div class="radio-group">
                    @Html.HiddenFor(x => x.RequestType.CustomFieldId, new { Value = Model.RequestType.CustomField.Id })
                    @Html.HiddenFor(model => model.SelectedRequestType, new { @class = "required-radio-value" })
                    @foreach (string requestType in Model.RequestTypes)
                    {
                        var rdId = "rd-" + requestType.Replace(' ', '_');
                        <p>
                            @Html.RadioButtonFor(x => x.RequestType.Value, requestType, new { id = rdId, @class = "required-radio" })
                            <label for="@rdId">@requestType</label>
                        </p>
                    }
                </div>
                @Html.ValidationMessageFor(x => x.SelectedRequestType)
            </div>
        </div>
        <div class="item-list height-auto" id="item-list">
            <div class="title item-head border">
                <span>@Resources.Views_Ticket_NewFacilityTicket_ItemList</span>
                <button class="btn btn-add" data-class="item-list"><span class="icon-add"></span>@Resources.Views_Ticket_NewFacilityTicket_AddItem</button>
            </div>

            @if (Model.Items != null)
            {
                for (int i = 0; i < Model.Items.Count; i++)
                {
                    var guid = Guid.NewGuid().ToString();

                    var evenClass = "";
                    if ((i % 2) != 0)
                    {
                        evenClass = "even";
                    }

                    <div class="item @evenClass">
                        @Html.CustomFieldIndex("Items", guid)

                        @Html.CustomFieldLabelWithGuidIndexFor(x => x.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "key border label-item" })
                        @Html.ValidationMessageFor(x => x.Items.ElementAt(i).ItemName, null, new { data_valmsg_for = "Items[" + guid + "].ItemName.Value" })
                        <div class="value border custom-dropdown">@Html.CustomFieldWithGuidIndexFor(x => x.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "" })</div>
                        <div class="border span-2">
                            <button class="btn btn-delete btn-delete-item"><span class="icon-delete"></span>@Resources.Views_Ticket_NewFacilityTicket_DeleteItem</button>
                        </div>

                        <div class="fullwidth border key">
                            @Html.CustomFieldLabelWithGuidIndexFor(x => x.Items.ElementAt(i).Reason, guid, "Items", new { @class = "" })
                            <span class="highlight">(<span class="countdown-character">5000</span> @Resources.Common_Form_Characters)</span>
                        </div>

                        <div class="fullwidth border input-area">@Html.CustomFieldWithGuidIndexFor(x => x.Items.ElementAt(i).Reason, guid, "Items", new { @class = "description" })</div>
                        @Html.ValidationMessageFor(x => x.Items.ElementAt(i).Reason, null, new { data_valmsg_for = "Items[" + guid + "].Reason.Value" })
                    </div>
                }
            }
        </div>

        @Html.Partial("_DropzoneView", Model)
    </div>
    <input type="submit" class="btn btn-primary btn-send" value="@Resources.Common_Form_Send" />
}