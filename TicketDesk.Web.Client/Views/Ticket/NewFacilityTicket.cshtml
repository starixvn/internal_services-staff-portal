@using TicketDesk.Localization.Client
@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers

@model TicketDesk.Web.Client.Models.Ticket.NewFacilityTicketViewModel

@section title { @New.Title }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
    <link href="~/src/css/custom-dropzone.css" rel="stylesheet" />
}

@section scripts
{
    @Html.Partial("_DropzoneScripts", Model)

    <script src="~/src/js/formhandler.js"></script>

    <script>
        function ResetFormValidator() {
            $(".ticket-form").removeData('validator');
            $(".ticket-form").removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse(".ticket-form");
            CheckFormAndTurnSubmitButton("ticket-form");
        }

        function GenerateGuid() {
            function s4() {
                return Math.floor((1 + Math.random()) * 0x10000)
                    .toString(16)
                    .substring(1);
            }

            return s4() + s4() + "-" + s4() + "-" + s4() + "-" + s4() + "-" + s4() + s4() + s4();
        }

        function AssignAddMoreButton() {
            $(".btn-add").click(function (event) {
                event.preventDefault();
                var id = "#" + $(this).data("class");
                var clone = $(id).children().last().clone();
                var guid = clone.children().first().val();
                var regex = new RegExp(guid, "g");
                var newHtml = clone.html(function (i, oldHtml) {
                    return oldHtml.replace(regex, GenerateGuid());
                });

                $(id).append(newHtml);

                ResetFormValidator();

                $(".btn-delete-item").show();
                $(".btn-delete-item:first").hide();

                var last = $(id).children().last();
                if ($(last).hasClass("even")) {
                    $(last).removeClass("even");
                } else {
                    $(last).addClass("even");
                }
            });
        }

        function AssignRemoveButton() {
            $(".btn-delete-item:first").hide();
            $("body").on("click", ".btn-delete-item", function () {
                $(this).parent().parent().remove();
                ResetFormValidator();
            });
        }

        $(document).ready(function () {
            AssignAddMoreButton();
            AssignRemoveButton();
        });
    </script>

    <script>
        $(document).ready(function () {
            InitFormHandler("ticket-form", true);

            // Default title for a ticket
            $(".ticket-title").val("[@Html.Raw(Resources.Views_Ticket_NewFacilityTicket_FormTitle)]");

            $(".ticket-form").on("change",
                function () {
                    var values = $(this).serializeArray();
                    var requestTypeValue = "";
                    for (var i = 0; i < values.length; i++) {
                        if (values[i].name === "RequestType.Value") {
                            requestTypeValue = values[i].value;
                            break;
                        }
                    }
                    $(".ticket-title").val("[@Html.Raw(Resources.Views_Ticket_NewFacilityTicket_FormTitle)] - " + requestTypeValue);
                });
        });
    </script>
}

@using (Html.BeginForm("NewFacilityTicket", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal ticket-form filechange", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @Html.HiddenFor(model => model.TempId)
    @Html.HiddenFor(model => model.SelectedRequestType, new { @class = "required-radio-value" })

    <div class="form-content facility-form">
        <div class="title">@Resources.Views_Ticket_NewFacilityTicket_Title</div>
        <div class="item-list">
            @Html.LabelFor(x => x.Ticket.Title, new { @class = "key border" })
            <div class="value span-3 border subject">
                @Html.TextBoxFor(x => x.Ticket.Title, new { @class = "ticket-title" })
            </div>
        </div>

        @Html.CustomFieldLabelFor(x => x.RequestType, new { @class = "key border" })
        <div class="value span-3 border">
            <div class="radio-group">
                @Html.HiddenFor(x => x.RequestType.CustomFieldId, new { Value = Model.RequestType.CustomField.Id })
                @foreach (string requestType in Model.RequestTypes)
                {
                    var rdId = "rd-" + requestType.Replace(' ', '_');
                    <p>
                        @Html.RadioButtonFor(x => x.RequestType.Value, requestType, new { id = rdId, @class = "required-radio" })
                        <label for="@rdId">@requestType</label>
                    </p>
                }
            </div>
        </div>
        <div class="item-list" id="item-list">
            <div class="title item-head border">
                <span>@Resources.Views_Ticket_NewFacilityTicket_ItemList</span>
                <button class="btn btn-add rippler rippler-default" data-class="item-list"><span class="icon-add"></span>@Resources.Views_Ticket_NewFacilityTicket_AddItem</button>
            </div>

            @if (Model.Items != null)
            {
                for (int i = 0; i < Model.Items.Count; i++)
                {
                    var guid = Guid.NewGuid().ToString();

                    var evenClass = "";
                    if ((i % 2) != 0)
                    {
                        evenClass = "even";
                    }

                    <div class="item @evenClass">
                        @Html.CustomFieldIndex("Items", guid)

                        @Html.CustomFieldLabelWithGuidIndexFor(x => x.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "key border" })
                        <div class="value border custom-dropdown">@Html.CustomFieldWithGuidIndexFor(x => x.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "" })</div>
                        <div class="border span-2">
                            <button class="btn btn-delete btn-delete-item rippler rippler-default"><span class="icon-delete"></span>@Resources.Views_Ticket_NewFacilityTicket_DeleteItem</button>
                        </div>

                        @Html.CustomFieldLabelWithGuidIndexFor(x => x.Items.ElementAt(i).Reason, guid, "Items", new { @class = "fullwidth border key" })
                        <div class="fullwidth border input-area">@Html.CustomFieldWithGuidIndexFor(x => x.Items.ElementAt(i).Reason, guid, "Items", new { @class = "" })</div>
                    </div>
                }
            }

        </div>

        @Html.Partial("_DropzoneView", Model)
    </div>
    <input type="submit" class="btn btn-primary btn-send rippler rippler-default" value="@Resources.Common_Form_Send"/>
}