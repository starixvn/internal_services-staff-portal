@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers
@model TicketDesk.Web.Client.Models.Ticket.NewFacilityTicketViewModel

@section title { @New.Title }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/dropzone/dropzone.min.js"></script>

    @Html.Partial("_DropzoneScripts", Model)

    <script>
        function GenerateGuid() {
            function s4() {
                return Math.floor((1 + Math.random()) * 0x10000)
                    .toString(16)
                    .substring(1);
            }

            return s4() + s4() + "-" + s4() + "-" + s4() + "-" + s4() + "-" + s4() + s4() + s4();
        }

        function AssignAddMoreButton() {
            $(".btn-add").click(function (event) {
                event.preventDefault();
                var id = "#" + $(this).data("class");
                var clone = $(id).children().last().clone();
                var guid = clone.children().first().val();
                var regex = new RegExp(guid, "g");
                var newHtml = clone.html(function (i, oldHtml) {
                    return oldHtml.replace(regex, GenerateGuid());
                });
                $(id).append(newHtml);

                $(".btn-delete").show();
                $(".btn-delete:first").hide();
            });
        }

        function AssignRemoveButton() {
            $(".btn-delete:first").hide();
            $("body").on("click", ".btn-delete", function () {
                $(this).parent().parent().remove();
            });
        }

        $(document).ready(function () {
            AssignAddMoreButton();
            AssignRemoveButton();
        });
    </script>
}

@using (Html.BeginForm("NewFacilityTicket", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal ticket-form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @Html.HiddenFor(model => model.TempId)

    <div class="form-content facility-form">
        <div class="title">REPAIRS AND SERVICES REQUISITION FORM</div>
        @Html.CustomFieldLabelFor(x => x.RequestType, new { @class = "key" })
        <div class="value span-3 border">
            <div class="radio-group">
                @Html.HiddenFor(x => x.RequestType.CustomFieldId, new { Value = Model.RequestType.CustomField.Id })
                @foreach (string requestType in Model.RequestTypes)
                {
                    var rdId = "rd-" + requestType.Replace(' ', '_');
                    <p>
                        @Html.RadioButtonFor(x => x.RequestType.Value, requestType, new { id = rdId })
                        <label for="@rdId">@requestType</label>
                    </p>
                }
            </div>
        </div>
        <div class="item-list" id="item-list">
            <div class="title item-head border">
                <span>Item list</span>
                <button class="btn btn-add" data-class="item-list"><span class="icon-add"></span>Add Item</button>
            </div>

            @if (Model.Items != null)
            {
                for (int i = 0; i < Model.Items.Count; i++)
                {
                    var guid = Guid.NewGuid().ToString();

                    <div class="item">
                        @Html.CustomFieldIndex("Items", guid)

                        @Html.CustomFieldLabelWithGuidIndexFor(x => x.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "key border" })
                        @Html.CustomFieldWithGuidIndexFor(x => x.Items.ElementAt(i).ItemName, guid, "Items", new { @class = "border" })
                        <div class="border span-2">
                            <button class="btn btn-delete"><span class="icon-delete"></span>Delete Item</button>
                        </div>

                        @Html.CustomFieldLabelWithGuidIndexFor(x => x.Items.ElementAt(i).Reason, guid, "Items", new { @class = "fullwidth border" })
                        @Html.CustomFieldWithGuidIndexFor(x => x.Items.ElementAt(i).Reason, guid, "Items", new { @class = "border" })
                    </div>
                }
            }

        </div>

        <div class="attach-file">
            <div class="key border">Attach files*:</div>
            <div class="value span-3 border">

                <button type="button" id="add-file-btn">Add files</button>

                <p class="dropzone-error-text"></p>

                <div class="dropzone-previews"></div>
            </div>
            <div class="fullwidth bold border"><span class="highlight">*</span>Max number of attachments: <span class="highlight">@Model.MaxNumberOfFile Files</span> | Max total size of attachments: <span class="highlight">@(Model.MaxBytes / 1048576) MB</span> | Allowed file types: <span class="highlight">@string.Join(", ", Model.AcceptedExtensions)</span></div>
        </div>
    </div>
    <input type="submit" class="btn btn-send" value="Send" />
                    }