@using TicketDesk.Core.Enumerations
@using TicketDesk.Core.Resources
@using TicketDesk.Web.Client.ViewModels.Ticket

@model TicketFeedbackViewModel

@section title {  Feedback }

@section scripts
{
    @Styles.Render("~/content/editor")
    @Styles.Render("~/content/select2")
    @Styles.Render("~/content/summernote")

    @Scripts.Render("~/bundles/select2")
    @Scripts.Render("~/bundles/select2_locale_" + CultureHelper.GetCurrentCulture())
    @Scripts.Render("~/bundles/markdown")
    @Scripts.Render("~/bundles/summernote")
    @Scripts.Render("~/bundles/summernote_locale_" + CultureHelper.GetCurrentCulture())
    @Scripts.Render("~/bundles/editor")
    @Scripts.Render("~/bundles/ticket-feedback")

    <script type="text/javascript">
        var isHtmlString = @(Model.Ticket.IsHtml ? "true" : "false");
        (function () {
            $.ajaxSetup({ cache: false });
            var uploaderConfig = {
                dropzoneUploadUrl: '@Url.Action("Upload", "File")',
                getAttachmentsUrl: '@Url.Action("GetAttachmentsInfo", "File")',
                deleteFileUrl: '@Url.Action("Delete", "File")',
                defaultThumbnailUrl: '@Url.Content("~/content/images/general-file.png")',
                ticketId: null
            };
            var tagsConfig = {
                tagAutoCompleteUrl: '@Url.Action("TagList", "AutoComplete")'
            };
            var detailsConfig = {
                isHtml: isHtmlString
            };
            window.ticketTags.activate(tagsConfig);
            window.ticketDetails.activate(detailsConfig);
            window.ticketFileUploader.activate(uploaderConfig);
        })();
    </script>
}
<main>
    <div class="container">
        <div class="col-lg-10 col-lg-offset-1 col-md-12">
            @using (Html.BeginForm("Feedback", "Ticket", null, FormMethod.Post, new { @id = "feedback-form", @class = "form-horizontal" }))
            {
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h2 class="panel-title">@ViewLang.Feedback</h2>
                    </div>
                    <div class="panel-body ">

                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary()

                        @foreach (var field in Model.CustomFields)
                        {
                            if (field.CustomFieldTypeId == (int)CustomFieldTypes.List)
                            {
                                <div class="form-group">
                                    @Html.Label(field.CustomFieldName, new { @class = "col-md-2 col-sm-1 control-label" })
                                    <div class="col-md-8 col-sm-11">
                                        @foreach (var value in field.PossibleValues)
                                        {
                                            <p>@Html.RadioButton(field.FormName, value, new { @class = "custom-field" }) @value</p>
                                        }
                                    </div>
                                </div>
                            }

                            if (field.CustomFieldTypeId == (int)CustomFieldTypes.String)
                            {
                                <div class="form-group">
                                    @Html.Label(field.CustomFieldName, new { @class = "col-md-2 col-sm-1 control-label focus" })
                                    <div class="col-md-8 col-sm-11">
                                        @Html.TextBox(field.FormName, "", new { @class = "form-control input-sm custom-field", tabindex = 1, autofocus = string.Empty })
                                    </div>
                                </div>
                            }

                            if (field.CustomFieldTypeId == (int)CustomFieldTypes.TextArea)
                            {
                                if (Model.Ticket.IsHtml)
                                {
                                    <div class="form-group">
                                        <label class="col-md-2 col-sm-1 control-label text-right" for="summernote">@field.CustomFieldName</label>
                                        <div class="col-md-8 col-sm-11">
                                            <textarea id="wmd-input-@field.FormName" name="Details" data-val-required="" data-val="true" class="custom-field"></textarea>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-group">
                                        <label class="col-md-2 col-sm-1 control-label text-right" for="wmd-input-xxx">@field.CustomFieldName</label>
                                        <div class="col-md-8 col-sm-11 wmd-panel">
                                            <div class="tabbable tabs-below">
                                                <div class="tab-content">
                                                    <div class="tab-pane fade in active" id="tab1">
                                                        <div id="wmd-button-bar-xxx" class="" style="display: inline-block"></div>
                                                        @Html.TextArea(field.FormName, new { id = "wmd-input-" + field.CustomFieldName, @class = "wmd-input form-control custom-field", data_val_required = "", data_val = "true", cols = "92", rows = "15", style = "height:200px", tabindex = 7 })
                                                    </div>
                                                    <div class="tab-pane fade" id="tab2">
                                                        <div class="row" style="min-height: 35px;"></div>

                                                        <div id="wmd-preview-xxx" class="wmd-panel wmd-preview form-control">
                                                        </div>
                                                    </div>
                                                </div>
                                                <ul class="nav nav-tabs navbar-right">
                                                    <li class="active"><a href="#tab1" data-toggle="tab"><i class="fa fa-edit"></i>&nbsp;ahihi_EditOption</a></li>
                                                    <li><a href="#tab2" data-toggle="tab"><i class="fa fa-eye"></i>&nbsp;ahihi_PreviewOption</a></li>
                                                </ul>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.Ticket.Details, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                }
                            }
                        }

                        <div class="form-group">
                            <label class="col-md-2 col-sm-1 control-label">@ViewLang.AttachFiles</label>
                            <div class="col-md-8 col-sm-11">
                                <div class="dropzone" style="min-height: 40px;" id="attachmentsDropZone">
                                    <div class="dz-message" data-dz-message><i class="fa fa-download "></i> ahihi_Attachment_Instructions</div>
                                    <div class="dropzone-previews" id="dz-preview"></div>
                                </div>

                                <p>@ViewLang.MaxNoAttachments</p>
                                <p>@ViewLang.AllowedFileTypes</p>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="">
                            <button type="submit" class="btn btn-success" tabindex="10">ahihi_SaveOption</button>&nbsp;&nbsp;
                            @Html.ActionLink("ahihi_Back", "Index")
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>