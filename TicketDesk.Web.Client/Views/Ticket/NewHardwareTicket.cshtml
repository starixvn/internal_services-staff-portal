@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Web.Client.Infrastructure.Helpers
@using TicketDesk.Localization.Client

@section title { @New.Title }

@model TicketDesk.Web.Client.Models.Ticket.NewHardwareTicketViewModel

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
    <link href="~/src/css/custom-dropzone.css" rel="stylesheet" />
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
}

@section scripts
{
    @Html.Partial("_DropzoneScripts", Model)
    <script src="~/src/js/formhandler.js"></script>
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.js"></script>
    <script>
        $(document).ready(function () {
            InitFormHandler("ticket-form", true);
            $('.datetimepicker').datetimepicker({
                format: 'DD/MM/YYYY hh:mm',
                defaultDate: new Date(),
                maxDate: new Date(),
                sideBySide: true
            });
        });
    </script>
}

@using (Html.BeginForm("NewHardwareTicket", "Ticket", null, FormMethod.Post, new { @class = "form-horizontal ticket-form filechange", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Ticket.IsHtml)
    @Html.HiddenFor(model => model.TempId)

    <div class="form-content hardware-form">
        <div class="title">HARDWARE FORM</div>
        <div class="item-list item">
            @Html.LabelFor(x => x.Ticket.Title, new { @class = "key fullwidth border" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.Ticket.Title)
            </div>
        </div>
        <div class="item-list item">
            @{
                var guid = Guid.NewGuid().ToString();
            }
            @*@Html.CustomFieldIndex("System", guid)*@

            @Html.CustomFieldLabelWithGuidIndexFor(x => x.System, guid, null, new { @class = "key border" })
            <div class="value border custom-dropdown">
                @Html.CustomFieldWithGuidIndexFor(x => x.System, guid, null, new { @class = "" })
            </div>
        </div>
        <div class="item-list item">
            @Html.CustomFieldLabelFor(x => x.TimeOfIncident, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.TimeOfIncident, new { @class = "key fullwidth datetimepicker input-append date", Style = "width: 100%", Value = @Model.TimeOfIncident.Value, Type = "text" })
            </div>
        </div>
        <div class="item-list item">
            <div class="key fullwidth">
                @Html.CustomFieldLabelFor(x => x.Description)
                <span class="highlight">(<span class="countdown-character">5000</span> @Resources.Common_Form_Characters)</span>
            </div>
            <div class="fullwidth">
                @Html.CustomFieldFor(x => x.Description, new { @class = "desciption" })
            </div>
        </div>
        @Html.Partial("_DropzoneView", Model)
    </div>
    <input type="submit" class="btn btn-primary btn-send" value="Send" />
}
