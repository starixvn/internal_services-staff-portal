@using TicketDesk.Localization.Views.Ticket
@using TicketDesk.Domain
@using TicketDesk.Domain.Model
@using TicketDesk.Web.Client.ViewModels.Ticket

@model TicketFeedbackViewModel

<div class="panel-heading" style="padding: 3px 5px;">
    <div class="row">
        <div class="row-same-height row-full-height">
            <div class="col-xs-2 col-sm-2 col-xs-height col-full-height text-center panel-title" style="border-right: 1px solid #dcdcdc;">
                @Model.Ticket.TicketStatus.GetDisplayName()
            </div>
            <div class="col-xs-2 col-sm-1 col-xs-height col-full-height text-center panel-title" style="border-right: 1px solid #dcdcdc;">
                @Model.Ticket.TicketId
            </div>
            <div class="col-xs-7 col-sm-9 col-xs-height col-full-height panel-title">
                @Model.Ticket.CategoryName
            </div>


        </div>
    </div>

</div>
<div class="panel-body" style="padding: 0">
    <div class="row row-no-padding row-same-height row-full-height" style="width: 100%;margin:0">
        <div class="col-md-8 col-sm-8 col-xs-12 col-xs-height col-full-height">
            <div class="container-fluid" style="padding: 0;">
                <div class="col-xs-12" style="border-bottom: 1px solid #B3CBDF; padding: 5px; background-color: #F7F7F7;">
                    <div class="pull-right">
                        @if (ViewBag.DisplayProjects ?? false)
                        {
                            <div class="text-primary">
                                <i class="fa fa-book"></i>
                                @Model.Ticket.Project.ProjectName
                            </div>
                        }


                    </div>
                    <div>
                        <div>
                            @Html.Raw(string.Format(Index.AssignedTo, string.IsNullOrEmpty(Model.Ticket.AssignedTo) ? "<span class='label label-warning'>" + Index.Unassigned + "</span>" : Model.Ticket.GetAssignedToInfo().DisplayName))
                        </div>
                        <div>
                            @Html.Raw(string.Format(Index.OwnedBy, Model.Ticket.GetOwnerInfo().DisplayName))
                        </div>
                        <div class="hidden-sm hidden-md hidden-lg">
                            @Html.Raw(string.Format(Index.UpdatedBy, Model.Ticket.GetLastUpdatedByInfo().DisplayName, Model.Ticket.LastUpdateDate.DateTime.ToShortDateString(), Model.Ticket.LastUpdateDate.DateTime.ToShortTimeString()))
                        </div>
                    </div>
                </div>
            </div>
            <div class="" style="margin: 0; padding: 0;">
                <div class="" id="detailsText" style="height: 200px; overflow: auto; margin: 0; padding: 5px;">
                   ahihiiihiih
                </div>
                <div id="detailTextExpander" class="expanderButton" style="height: 20px; display: none;">
                    <i id="expandersymbol" class="fa fa-chevron-down text-center"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-4 hidden-xs col-sm-height col-full-height col-top" style="border-left: 1px solid #B3CBDF;background-color: #F7F7F7;">
            <div class="container-fluid" style="padding: 0;">
                <aside class="small">
                    <div style="padding: 5px;">
                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.TicketStatus, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.TicketStatus.GetDisplayName()
                            </div>
                        </div>
                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.LastUpdateBy, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.GetLastUpdatedByInfo().DisplayName
                            </div>
                        </div>
                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.LastUpdateDate, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.LastUpdateDate.DateTime.ToShortDateString() @Model.Ticket.LastUpdateDate.DateTime.ToShortTimeString()
                            </div>
                        </div>

                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.CurrentStatusSetBy, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.GetCurrentStatusSetByInfo().DisplayName
                            </div>
                        </div>
                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.CurrentStatusDate, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.CurrentStatusDate.DateTime.ToShortDateString() @Model.Ticket.CurrentStatusDate.DateTime.ToShortTimeString()
                            </div>
                        </div>
                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.CreatedBy, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.GetCreatedByInfo().DisplayName
                            </div>
                        </div>
                        <div class="row">
                            @Html.LabelFor(m => m.Ticket.CreatedDate, new { @class = "col-sm-5 col-lg-4 text-right" })
                            <div class="col-sm-7 col-lg-8">
                                @Model.Ticket.CreatedDate.DateTime.ToShortDateString() @Model.Ticket.CreatedDate.DateTime.ToShortTimeString()
                            </div>
                        </div>

                        @*<div class="row">
                            <label class="col-sm-5 col-lg-4 text-right">@Index.Subscribers</label>
                            <div class="col-sm-7 col-lg-8">

                                @foreach (var sub in Model.TicketSubscribers)
                                {
                                    <div>@sub.GetSubscriberDisplayInfo().DisplayName</div>
                                }
                            </div>
                        </div>*@
                    </div>

                </aside>
            </div>
        </div>
    </div>
</div>
