@model TicketDesk.Web.Client.Models.Home.Pagination
    
<div class="page-size">
    <label class="">@Html.DisplayNameFor(x => x.ItemPerPage)</label>
    <div class="custom-dropdown">
        @Html.DropDownListFor(x => x.ItemPerPage, Model.ItemPerPageList, new { id = "itemperpage-select" })
    </div>
</div>

<ul class="pagination">
    @if (Model.CurrentPage == 1)
    {
        <li>
            <a class="icon-previous disabled"></a>
        </li>
    }
    else
    {
        <li><a href="@Url.Action(Model.Action, Model.Controller, new { page = (Model.CurrentPage - 1), itemPerPage = Model.ItemPerPage })" class="icon-previous"></a></li>
    }
    @for (int i = 0; i < Model.TotalPage; i++)
    {
        var activeClass = "";
        if (Model.CurrentPage == (i + 1))
        {
            activeClass = "active";
        }

        <li class="@activeClass"><a href="@Url.Action(Model.Action, Model.Controller, new { page = (i + 1), itemPerPage = Model.ItemPerPage })">@(i + 1)</a></li>
    }
    @if (Model.CurrentPage == Model.TotalPage)
    {
        <li>
            <a class="icon-next disabled"></a>
        </li>
    }
    else
    {
        <li><a href="@Url.Action(Model.Action, Model.Controller, new { page = (Model.CurrentPage + 1), itemPerPage = Model.ItemPerPage })" class="icon-next"></a></li>
    }
</ul>

<p class="display-item">Displaying @Model.FromItemIndex to @Model.ToItemIndex of @Model.TotalItem item(s)</p>
