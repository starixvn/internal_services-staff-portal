@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Common.Pagination

<div class="page-size">
    <label class="">@Html.DisplayNameFor(x => x.ItemPerPage)</label>
    <div class="custom-dropdown js-dropdown">
        @*@Html.DropDownListFor(x => x.ItemPerPage, Model.ItemPerPageList, new { id = "itemperpage-select" })*@
        <input type="hidden" name="Framework" id="Framework" class="js-dropdown__input">
        <span class="c-button c-button--dropdown js-dropdown__current">20</span>

        <ul class="c-dropdown__list">
            @foreach (var size in Model.PageSizes)
            {
                var selectedClass = "";
                if (Model.ItemPerPage == size)
                {
                    selectedClass = "selected";
                }

                <li class="@selectedClass c-dropdown__item" data-dropdown-value="@size">
                    <a href="@Model.PageSizeLink(size)">@size</a>
                </li>
            }
        </ul>
    </div>
</div>

<ul class="pagination">
    @if (Model.CurrentPage == 1)
    {
        <li>
            <a class="icon-previous disabled"></a>
        </li>
    }
    else
    {
        @*<li><a href="@Url.Action(Model.Action, Model.Controller, new { page = (Model.CurrentPage - 1), itemPerPage = Model.ItemPerPage })" class="icon-previous"></a></li>*@
        <li><a href="@Model.PreviousLink()" class="icon-previous"></a></li>
    }

    @for (int i = 0; i < Model.TotalPage; i++)
    {
        var activeClass = "";
        if (Model.CurrentPage == (i + 1))
        {
            activeClass = "active";
        }

        <li class="@activeClass">
            @*<a href="@Url.Action(Model.Action, Model.Controller, new { page = (i + 1), itemPerPage = Model.ItemPerPage })">@(i + 1)</a>*@
            <a href="@Model.IndexLink(i + 1, Model.ItemPerPage)">@(i + 1)</a>
        </li>
    }

    @if (Model.CurrentPage == Model.TotalPage)
    {
        <li>
            <a class="icon-next disabled"></a>
        </li>
    }
    else
    {
        <li>
            @*<a href="@Url.Action(Model.Action, Model.Controller, new { page = (Model.CurrentPage + 1), itemPerPage = Model.ItemPerPage })" class="icon-next"></a>*@
            <a href="@Model.NextLink()" class="icon-next"></a>
        </li>
    }
</ul>

<p class="display-item">@string.Format(Resources.Common_Table_Pagination_DisplayingText, Model.FromItemIndex, Model.ToItemIndex, Model.TotalItem)</p>