@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Common.Pagination

<p class="display-item">@string.Format(Resources.Common_Table_Pagination_DisplayingText, Model.FromItemIndex, Model.ToItemIndex, Model.TotalItem)</p>

<ul class="pagination">
    @if (Model.CurrentPage == 1)
    {
        <li>
            <a class="icon-previous disabled"></a>
        </li>
    }
    else
    {
        <li><a href="@Model.PreviousLink()" class="icon-previous ajax"></a></li>
    }

    @for (int i = 0; i < Model.TotalPage; i++)
    {
        var activeClass = "";
        if (Model.CurrentPage == (i + 1))
        {
            activeClass = "active";
        }

        <li class="@activeClass">
            <a href="@Model.IndexLink(i + 1, Model.ItemPerPage)" class="ajax">@(i + 1)</a>
        </li>
    }

    @if (Model.CurrentPage == Model.TotalPage || Model.TotalPage == 0)
    {
        <li>
            <a class="icon-next disabled"></a>
        </li>
    }
    else
    {
        <li>
            <a href="@Model.NextLink()" class="icon-next ajax"></a>
        </li>
    }
</ul>

<div class="page-size">
    <label class="">@Html.DisplayNameFor(x => x.ItemPerPage)</label>
    <div class="custom-dropdown js-dropdown">
        <span class="c-button c-button--dropdown js-dropdown__current">@Model.ItemPerPage</span>

        <ul class="c-dropdown__list">
            @foreach (var size in Model.PageSizes)
            {
                var selectedClass = "";
                if (Model.ItemPerPage == size)
                {
                    selectedClass = "selected";
                }

                <li class="@selectedClass c-dropdown__item" data-dropdown-value="@size">
                    <a href="@Model.PageSizeLink(size)" class="ajax">@size</a>
                </li>
            }
        </ul>
    </div>
</div>