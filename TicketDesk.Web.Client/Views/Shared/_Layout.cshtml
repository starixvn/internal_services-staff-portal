    <div class="page-container">

        @Html.Action("Menu", "Home")

        <div class="content">
            @RenderBody()
        </div>
    </div>


    <!-- Modal confirm logout -->
    <div class="modal fade" id="logOut" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@Messages.LogoutConfirmation</h4>
                </div>
                <div class="modal-body">
                    <p>@Messages.LogoutModalDescription</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-default" id="confirmLogOut">@Messages.Yes</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">@Messages.No</button>
                </div>
            </div>
        </div>
    </div>



