<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="msapplication-config" content="none" />
    <link rel="shortcut icon" type="image/x-icon" href="~/src/contents/images/favicon.png" />
    <title>@RenderSection("title", required: false)</title>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700" rel="stylesheet">
    <link href="~/src/libs/bootstrap-3.3.7/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/src/libs/normalize.css" rel="stylesheet" />
    <link href="~/src/libs/rippler/css/rippler.min.css" rel="stylesheet" />
    <link href="~/src/Fonts/iconFont/style.css" rel="stylesheet" />
    <link href="~/src/libs/select2/select2.min.css" rel="stylesheet" />

    @RenderSection("css", false)
    <link href="~/src/css/page.css" rel="stylesheet" />
    @RenderSection("customHeader", required: false)
</head>
<body>

    <div class="page-container">

        @Html.Action("Menu", "Home")

        <div class="content">
            @RenderBody()
        </div>
    </div>

    @*<script type="text/javascript">
            window.currentCulture = '@CultureHelper.GetCurrentCulture()';
        </script>*@
    @*@Scripts.Render("~/bundles/common")
        @Scripts.Render("~/bundles/common_locale_" + CultureHelper.GetCurrentCulture())*@
    @*<script type="text/javascript">
            Globalize.culture(window.currentCulture);

            //Fix to decimal separator validation
            var _number = $.validator.methods.number;
            $.validator.methods.number = function (value, element) {
                return _number.call(this, Globalize.parseFloat(value), element);
            };
            var _range = $.validator.methods.range;
            $.validator.methods.range = function (value, element, param) {
                return _range.call(this, Globalize.parseFloat(value), element, param);
            };
        </script>*@

    @*<script type="text/javascript">
            $(document).ready(function () {
                $('[data-toggle="tooltip"]').tooltip();
            });
        </script>*@

    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    <script src="~/src/libs/jquery/1.12.4/jquery-1.12.4.min.js"></script>

    <!-- Include all compiled plugins (below), or include individual files as needed -->
    <script src="~/src/libs/bootstrap-3.3.7/js/bootstrap.min.js"></script>
    <script src="~/src/libs/Touch/touche.js"></script>
    <script src="~/src/libs/rippler/js/jquery.rippler.min.js"></script>
    <script src="~/src/libs/select2/select2.min.js" type="text/javascript"></script>
    @Scripts.Render("~/bundles/validate")
    <script src="~/src/js/common.js"></script>
    <script src="~/src/js/page.js"></script>
    @*<script src="~/src/js/pagination.js" type="text/javascript"></script>*@

    @RenderSection("scripts", required: false)
</body>
</html>