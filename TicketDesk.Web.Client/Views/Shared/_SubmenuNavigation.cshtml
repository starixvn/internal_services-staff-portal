@using TicketDesk.Web.Client.Models.Extensions
@model IEnumerable<MenuItem>

<ul class="extend-menu">
    @foreach (var menu in Model)
    {
        var activeActionClass = Html.IsExactMatch(menu.Url);
        <li><a href='@menu.Url' class='@activeActionClass'><i class='@menu.Description hovicon'></i><span class='text'>@menu.Name</span></a></li>
    }
</ul>

@section scripts{
    <script>
        $(document).ready(function() {
            $(".submenu").removeClass("active");
        });
    </script>
}