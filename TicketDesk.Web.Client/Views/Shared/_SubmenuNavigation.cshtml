@using TicketDesk.Web.Client.Infrastructure.Extensions
@using TicketDesk.Web.Client.Models.Extensions
@model IEnumerable<MenuItem>
    
@section title { @ViewBag.Title }


<ul class="extend-menu">
    @foreach (var menu in Model)
    {
        var activeActionClass = Html.IsExactMatch(menu.Url);
        <li><a class='@activeActionClass' link='@menu.Url'><i class='@menu.IconClass hovicon'></i><span class='text'>@menu.Name</span></a></li>
    }
</ul>

@section scripts{
    <script>
        $(document).ready(function() {
            $(".submenu").removeClass("active");

            $('.extend-menu a').click(function () {
                var link = $(this).attr('link');
                setTimeout(function () {
                    window.location = link;
                }, 800);
            });

        });
    </script>
}