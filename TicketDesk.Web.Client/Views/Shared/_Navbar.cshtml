@using TicketDesk.Web.Client.Models.Extensions

@model TicketDesk.Web.Client.Models.NavbarViewModel

<div class="sticky-header">
    <div class="logo">
        <a href="@Url.Action("Index","Home")">
            <img src="~/src/contents/images/logo.svg" class="img-logo" />
        </a>
    </div>

    <ul class="main-menu">

        @foreach (MenuItem menu in Model.MenuItems)
        {
            var menuLink = "#";
            if (!string.IsNullOrEmpty(menu.Url))
            {
                menuLink = menu.Url;
            }

            var menuClass = Html.IsActiveRoute(menuLink);

            <li class="@menuClass"><a href="@menuLink" class="menu-item"><i class="@menu.IconClass"></i><span class="text">@menu.Name</span></a></li>
        }

        @Html.Partial("_UserMenu", Model)
    </ul>

</div>

<div class="submenu-section">
    @foreach (MenuItem menu in Model.MenuItems)
    {
        var menuLink = "#";
        if (!string.IsNullOrEmpty(menu.Url))
        {
            menuLink = menu.Url;
        }
        var activeParentMenuClass = Html.IsActiveRoute(menuLink);

        if (menu.Children.Any())
        {
            <ul class="submenu @activeParentMenuClass">
                @foreach (var childItem in menu.Children)
                {
                    var activeActionClass = Html.IsExactMatch(childItem.Url);
                    <li><a href='@childItem.Url' class='@activeActionClass'><i class='@childItem.IconClass'></i><span class='text'>@childItem.Name</span></a></li>
                }
            </ul>
        }
    }
</div>

