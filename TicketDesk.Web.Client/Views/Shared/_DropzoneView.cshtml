@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Ticket.TicketWithFilesBaseViewModel

<div id="attach-file-modal" class="modal fade" role="dialog">
    <div class="modal-dialog small-modal">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">@Resources.Dropzone_Error_Sorry</h4>
            </div>
            <div class="modal-body">
                <p class="dropzone-error-text"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary rippler rippler-default" data-dismiss="modal">@Resources.Dropzone_Modal_Close</button>
            </div>
        </div>

    </div>
</div>

<div class="attach-file">
    <div class="key border"><span class="text">@Resources.Dropzone_Form_AttachFiles<span class="highlight">*</span></span></div>
    <div class="value span-3 border">

        <button type="button" id="add-file-btn" class="btn btn-browser rippler rippler-default">@Resources.Dropzone_Form_Browse</button>
        <div class="number-chosenfile"><span class="number"></span>&nbsp;<span class="text"></span></div>
        <button type="button" class="btn btn-delete btn-delete-all-file rippler rippler-default"><span class="icon-delete"></span>@Resources.Dropzone_Form_DeleteAll</button>
        <div class="clearfix"></div>
        <div class="dropzone-previews">
        </div>
    </div>
    <div class="fullwidth bold border"><span class="highlight">*</span>@Resources.Dropzone_Form_TotalFiles<span class="highlight">@Model.MaxNumberOfFile Files</span> | @Resources.Dropzone_Form_TotalSize<span class="highlight">@(Model.MaxBytes / 1048576) MB</span> | @Resources.Dropzone_Form_AllowedTypes<span class="highlight">@string.Join(", ", Model.AcceptedExtensions)</span></div>
</div>
