@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Models.Ticket.TicketWithFilesBaseViewModel

<div class="hidden dropzone-params">
    <p id="dz-isfilerequired">@Json.Encode(Model.IsFileRequired)</p>
    <p id="dz-maxnumberoffile">@Model.MaxNumberOfFile</p>
    <p id="dz-maxbytes">@Model.MaxBytes</p>
    <p id="dz-acceptedextensions">@string.Join(",", Model.AcceptedExtensions)</p>

    <p id="dz-error-filerequired">Attached file is required!</p>
    <p id="dz-error-maxfilesviolated">@string.Format("Max number of attachments exceeded {0}", Model.MaxNumberOfFile)</p>
    <p id="dz-error-totalsizeviolated">@string.Format("Total size of attachments exceeded {0} MB", Model.MaxBytes / 1048576)</p>
    <p id="dz-error-filetypeviolated">@string.Format("Attachments must be {0}", string.Join(",", Model.AcceptedExtensions))</p>
    <p id="dz-error-duplicatedfile">@Resources.Dropzone_Error_DuplicateFile</p>

    <p id="dz-info-multiplefileselected">@Html.Raw(Resources.Dropzone_Info_MultipleFilesSelected)</p>
    <p id="dz-info-singlefileselected">@Html.Raw(Resources.Dropzone_Info_SingleFileSelected)</p>

    <p id="dz-dict-dictDefaultMessage">@Html.Raw(Resources.Dropzone_Message_Default)</p>
    <p id="dz-dict-dictFallbackMessage">@Html.Raw(Resources.Dropzone_Message_Fallback)</p>
    <p id="dz-dict-dictFallbackText">@Html.Raw(Resources.Dropzone_Message_FallbackText)</p>
    <p id="dz-dict-dictFileTooBig">@Html.Raw(Resources.Dropzone_Message_FileTooBig)</p>
    <p id="dz-dict-dictInvalidFileType">@Html.Raw(Resources.Dropzone_Message_InvalidFileType)</p>
    <p id="dz-dict-dictResponseError">@Html.Raw(Resources.Dropzone_Message_ResponseError)</p>
    <p id="dz-dict-dictCancelUpload">@Html.Raw(Resources.Dropzone_Message_CancelUpload)</p>
    <p id="dz-dict-dictCancelUploadConfirmation">@Html.Raw(Resources.Dropzone_Message_CancelUploadConfirmation)</p>
    <p id="dz-dict-dictRemoveFile">@Html.Raw(Resources.Dropzone_Message_RemoveFile)</p>
    <p id="dz-dict-dictMaxFilesExceeded">@Html.Raw(Resources.Dropzone_Message_MaxFilesExceeded)</p>

    <a id="dz-action-delete" href="@Url.Action("Delete", "File", new {id = Model.TempId})"></a>
    <a id="dz-action-upload" href="@Url.Action("Upload", "File", new {tempId = Model.TempId})"></a>
</div>

<div id="attach-file-modal" class="modal fade" role="dialog">
    <div class="modal-dialog small-modal">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">@Resources.Dropzone_Error_Sorry</h4>
            </div>
            <div class="modal-body">
                <pre class="dropzone-error-text"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">@Resources.Dropzone_Modal_Close</button>
            </div>
        </div>

    </div>
</div>

<div class="attach-file height-auto">
    <div class="key border label-item">
        <span class="text">@Resources.Dropzone_Form_AttachFiles</span>
    </div>
    <div class="value span-3 border">

        <button type="button" id="add-file-btn" class="btn btn-browser">@Resources.Dropzone_Form_Browse</button>
        <div class="number-chosenfile"><span class="number"></span>&nbsp;<span class="text"></span></div>
        <button type="button" class="btn btn-delete btn-delete-all-file"><span class="icon-delete"></span>@Resources.Dropzone_Form_DeleteAll</button>
        <div class="clearfix"></div>
        <div class="dropzone-previews">
        </div>
    </div>
    <div class="fullwidth bold border"><span class="highlight">*</span>@Resources.Dropzone_Form_TotalFiles<span class="highlight">@Model.MaxNumberOfFile Files</span> | @Resources.Dropzone_Form_TotalSize<span class="highlight">@(Model.MaxBytes / 1048576) MB</span> | @Resources.Dropzone_Form_AllowedTypes<span class="highlight">@string.Join(", ", Model.AcceptedExtensions)</span></div>
</div>
