@model TicketDesk.Web.Client.Models.Ticket.TicketWithFilesBaseViewModel

<script src="~/src/libs/dropzone/dropzone.min.js"></script>

<script type="text/javascript">
    
    function CheckValidFiles() {
        var result = false;
        var rejectedFiles = ticketDeskDropzone.getRejectedFiles();

        if (ticketDeskDropzone.files.length > 0 && rejectedFiles.length === 0) {
            // have file(s)
            result = true;
        }

        return result;
    }

    function SetErrorTextAndShowModal(text) {
        if (text !== "") {
            $(".dropzone-error-text").text(text);
            if (($("element").data('bs.modal') || {}).isShown) {
                $('#attach-file-modal').modal('hide');
            }

            $("#attach-file-modal").modal();
        }
    }

    function ResumeQube(dropzone) {
        // Prevent removedfile event get called multiple time
        isRequeueing = true;

        var files = dropzone.getRejectedFiles();
        var copiedFiles = files.slice(0);
        for (var i = 0; i < copiedFiles.length; i++) {
            dropzone.removeFile(files[i]);
            dropzone.addFile(copiedFiles[i]);
        }

        isRequeueing = false;
    }

    function GetTotalSize() {
        var totalBytes = 0;
        for (var i = 0; i < ticketDeskDropzone.files.length; i++) {
            if (ticketDeskDropzone.files[i] != undefined && ticketDeskDropzone.files[i].size != undefined) {
                var filesize = parseInt(ticketDeskDropzone.files[i].size);
                totalBytes = totalBytes + filesize;
            }
        }
        return totalBytes;
    }

    function IsTotalBytesViolated() {
        var allowedBytes = @Model.MaxBytes;
        var totalBytes = GetTotalSize();

        return totalBytes > allowedBytes;
    }

    function CheckTotalBytes() {
        if (IsTotalBytesViolated()) {
            var totalMb = @Model.MaxBytes / 1048576;
            SetErrorTextAndShowModal("Total size exceed maximum allowed of " + totalMb + " MB");
        } else {
            SetErrorTextAndShowModal("");
        }
    }

    function CheckDuplicateFile(dropzone, file) {
        if (dropzone.files.length) {
            var i, len;
            var isDuplicate = false;
            var errorText = "Duplicate file: ";

            for (i = 0, len = dropzone.files.length; i < len - 1; i++) // -1 to exclude current file
            {
                if (dropzone.files[i].name === file.name &&
                    dropzone.files[i].size === file.size &&
                    dropzone.files[i].lastModifiedDate.toString() === file.lastModifiedDate.toString()) {
                    dropzone.removeFile(file);
                    errorText += file.name + " | ";
                    isDuplicate = true;
                }
            }

            if (isDuplicate) {
                errorText = errorText.slice(0, -3);

                SetErrorTextAndShowModal(errorText);
            } else {
                SetErrorTextAndShowModal("");
            }
        }
    }

    function UpdateNumberOfSelectedFile(dropzone) {
        var numberOfSelectedFile = dropzone.files.length;
        $('.number-chosenfile .number').text(numberOfSelectedFile);
        if (numberOfSelectedFile > 1) {
            $('.btn-delete-all-file').show();
            $('.number-chosenfile').show();            
            $('.number-chosenfile .text').text('files were selected');
        } else if (numberOfSelectedFile == 1) { 
            $('.btn-delete-all-file').show();
            $('.number-chosenfile').show(); 
            $('.number-chosenfile .text').text('file were selected');
        }
        else {            
            $('.number-chosenfile').hide();
            $('.btn-delete-all-file').hide();
        }
    }

    Dropzone.autoDiscover = false;

    var isRequeueing = false;

    var ticketDeskDropzone = new Dropzone("#add-file-btn",
        {
            url: '@Url.Action("Upload", "File", new { tempId = Model.TempId })',
            uploadMultiple: true,
            parallelUploads: 1,
            maxFiles: @Model.MaxNumberOfFile,
            createImageThumbnails: false,
            acceptedFiles: "@string.Join(", ",Model.AcceptedExtensions)",
            addRemoveLinks: true,
            previewsContainer: ".dropzone-previews",
            clickable: "#add-file-btn",
            init: function() {
                this.on("removedfile",
                    function(file) {
                        var deleteUrl = '@Url.Action("Delete", "File", new {id = Model.TempId})' +
                            "&fileName=" +
                            file.name;

                        if (file.status === "success") {
                            $.ajax({
                                url: deleteUrl,
                                method: "POST"
                            });
                            SetErrorTextAndShowModal("");
                            if (isRequeueing === false) {
                                ResumeQube(this);
                            }
                        }

                        UpdateNumberOfSelectedFile(this);
                    });
                this.on("addedfile",
                    function(file) {
                        $(".dropzone-previews").addClass("dropzone");

                        CheckTotalBytes();
                        CheckDuplicateFile(this, file);
                        UpdateNumberOfSelectedFile(this);
                    });
                this.on("reset",
                    function() {
                        $(".dropzone-previews").removeClass("dropzone");
                        SetErrorTextAndShowModal("");
                    });
                this.on("maxfilesexceeded",
                    function() {
                        SetErrorTextAndShowModal("Total of file exceeded limit");
                    });
            }
        });

    $(document).ready(function() {
        $(".btn-delete-all-file").on("click",
            function() {
                var files = ticketDeskDropzone.files;
                for (var i = 0; i < files.length; i++) {
                    ticketDeskDropzone.removeFile(files[i]);
                }
            });
    });
</script>