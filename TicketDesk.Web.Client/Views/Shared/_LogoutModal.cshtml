@using TicketDesk.Core.Resources

<!-- Modal confirm logout -->
<div class="modal fade" id="logOut" role="dialog">
    <div class="modal-dialog small-modal">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"></button>
                <h4 class="modal-title">@Messages.LogoutConfirmation</h4>
            </div>
            <div class="modal-body">
                <p>@Messages.LogoutModalDescription</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-dismiss="modal">@Messages.No</button>
                <button type="submit" class="btn btn-primary" id="confirmLogOut">@Messages.Yes</button>                
            </div>
        </div>
    </div>
</div>
