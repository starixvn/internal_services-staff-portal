{
    @SignIn.Title
}

    @*<p>@SignIn.FixedMessageAppear</p>*@
    @using (Html.BeginForm("SignIn", "User", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new {@id = "user-login-form", @class = "form-horizontal", role = "form" }))
    {
        @Html.AntiForgeryToken()
        @*<div class="login-form">
            <div class="logo"><img src="~/src/contents/images/logo.png"/></div>
            @Html.ValidationSummary(true, "")
            <div class="field">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email)
                @Html.ValidationMessageFor(m => m.Email, "")
            </div>
            <div  class="field">
