@using TicketDesk.Domain.Model
@model SingleTicketViewModel

@{
    Layout = "";
}

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;">
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <style type="text/css">

        img {
            max-width: 100%;
        }

        body {
            -webkit-font-smoothing: antialiased;
            -webkit-text-size-adjust: none;
            width: 100% !important;
            height: 100%;
            line-height: 1.6em;
            background-color: #f6f6f6;
        }

        .file-attachments {
            text-decoration: none;
        }

            .file-attachments:hover {
                text-decoration: underline;
            }

        @@media only screen and (max-width: 640px) {
            body {
                padding: 0 !important;
            }

            h1 {
                font-weight: 800 !important;
                margin: 20px 0 5px !important;
            }

            h2 {
                font-weight: 800 !important;
                margin: 20px 0 5px !important;
            }

            h3 {
                font-weight: 800 !important;
                margin: 20px 0 5px !important;
            }

            h4 {
                font-weight: 800 !important;
                margin: 20px 0 5px !important;
            }

            h1 {
                font-size: 22px !important;
            }

            h2 {
                font-size: 18px !important;
            }

            h3 {
                font-size: 16px !important;
            }

            .container {
                padding: 0 !important;
                width: 100% !important;
            }

            .content {
                padding: 0 !important;
            }

            .content-wrap {
                padding: 10px !important;
            }

            .invoice {
                width: 100% !important;
            }
        }
    </style>
</head>

@{
    var detailLink = Request.Url.GetLeftPart(UriPartial.Authority) + "/TicketList/TicketDetails?ticketId=" + Model.Ticket.TicketId;
}

<body itemscope=itemscope itemtype="http://schema.org/EmailMessage" style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; line-height: 1.6em; background-color: #eaeced; margin: 0;" bgcolor="#eaeced">
    <table class="body-wrap" style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; width: 100%; background-color: #eaeced; margin: 0;" bgcolor="#eaeced">
        <tr style="margin: 0;">
            <td style="vertical-align: top; margin: 0;" valign="top"></td>
            <td class="container" width="600" style="display: block !important; max-width: 600px !important; clear: both !important; margin: 20px auto 0;" valign="top">
                <div class="content" style="max-width: 600px; display: block; margin: 0 auto;">
                    <table class="main" width="100%" cellpadding="0" cellspacing="0" style="border-radius: 3px; background-color: #fff; margin: 0; border: 1px solid #e9e9e9;" bgcolor="#fff">
                        <tr style="margin: 0;">
                            <td class="content-wrap aligncenter" style="vertical-align: top; text-align: center; margin: 0; padding: 20px;" align="center" valign="top">
                                <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0;">
                                    <tr style="margin: 0;">
                                        <td class="content-block" style="text-align: left;">
                                            <img class="logo" width="140" src="data:image/svg+xml;base64," />
                                            <a class="link" href="@detailLink" style="float: right; color: #1c7deb; margin-top: 15px;">View in browser</a>
                                        </td>
                                    </tr>
                                    <tr style="margin: 0;">
                                        <td class="content-block aligncenter" style="vertical-align: top; text-align: center; margin: 0; padding: 0 0 20px;" align="center" valign="top">
                                            <table class="invoice" style="text-align: left; width: 100%; margin: 15px auto 0; border: 1px solid #d4d4d4; border-collapse: collapse;">
                                                <tbody>
                                                    <tr style="margin: 0;">
                                                        <td width="140px" style="vertical-align: middle; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px; background: #2e4592; color: #fff;" valign="top">Title: </td>
                                                        <td class="alignright" style="vertical-align: middle; text-align: left; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px;" align="right" valign="top">@Model.Ticket.Title</td>
                                                    </tr>
                                                    <tr style="margin: 0;">
                                                        <td width="140px" style="vertical-align: middle; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px; background: #2e4592; color: #fff;" valign="top">Created Date: </td>
                                                        <td class="alignright" style="vertical-align: middle; text-align: left; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px;" align="right" valign="top">@Model.Ticket.CreatedDate</td>
                                                    </tr>
                                                    <tr style="margin: 0;">
                                                        <td width="140px" style="vertical-align: middle; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px; background: #2e4592; color: #fff;" valign="top">Status: </td>
                                                        <td class="alignright" style="vertical-align: middle; text-align: left; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px;" align="right" valign="top">@Model.Ticket.TicketStatus</td>
                                                    </tr>
                                                    <tr style="margin: 0;">
                                                        <td width="140px" style="vertical-align: middle; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px; background: #2e4592; color: #fff;" valign="top">Shop: </td>
                                                        <td class="alignright" style="vertical-align: middle; text-align: left; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px;" align="right" valign="top">@Model.ShopName</td>
                                                    </tr>
                                                    <tr style="margin: 0;">
                                                        <td width="140px" style="vertical-align: middle; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px; background: #2e4592; color: #fff;" valign="top">Created By: </td>
                                                        <td class="alignright" style="vertical-align: middle; text-align: left; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px;" align="right" valign="top">@Model.CreatedByUsername</td>
                                                    </tr>
                                                    <tr style="margin: 0;">
                                                        <td width="140px" style="vertical-align: middle; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px; background: #2e4592; color: #fff;" valign="top">Last Updated By: </td>
                                                        <td class="alignright" style="vertical-align: middle; text-align: left; border-top-width: 1px; border-top-color: #d4d4d4; border-top-style: solid; margin: 0; padding: 5px 10px;" align="right" valign="top">@Model.UpdatedByUsername</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    
                                    @if (!string.IsNullOrEmpty(Model.TicketEditedMessage))
                                    {
                                        <tr style="margin: 0;">
                                            <td class="content-block" style="vertical-align: top; text-align: left; margin: 0; padding: 0 0 10px;" align="center" valign="top">
                                                <p style="font-weight: bold; color: #2e4592; margin: 0;">Ticket Edited</p>
                                                <p style="margin: 0;">Status Changed: @Model.TicketEditedMessage</p>
                                            </td>
                                        </tr>
                                    }

                                    <tr style="margin: 0;">
                                        <td class="content-block" style="vertical-align: top; text-align: left; margin: 0; padding: 0 0 10px;" align="center" valign="top">
                                            <p style="font-weight: bold; color: #2e4592; margin: 0;">Ticket Details</p>
                                            @{
                                                var nonGroupCustomFieldValues = Model.CustomFieldValues.Where(x => x.GroupId == null);
                                                foreach (var customFieldValue in nonGroupCustomFieldValues)
                                                {
                                                    <p style="margin: 0;">
                                                        <span>@customFieldValue.CustomField.Name: </span>
                                                        <span>@customFieldValue.Value</span>
                                                    </p>
                                                }
                                            }
                                        </td>
                                    </tr>

                                    @{
                                        var groupedCustomFieldValues = Model.CustomFieldValues.Where(x => x.GroupId != null).GroupBy(x => x.GroupId);
                                        foreach (IGrouping<string, CustomFieldValue> group in groupedCustomFieldValues)
                                        {
                                            var customFieldValues = group.ToList();
                                            <tr style="margin: 0;">
                                                <td class="content-block" style="vertical-align: top; text-align: left; margin: 0; padding: 0 0 10px;" align="center" valign="top">
                                                    <ul style="padding: 0 0 0 17px; margin: 0;">
                                                        @foreach (var customFieldValue in customFieldValues)
                                                        {

                                                            <li><strong style="color: #333;">@customFieldValue.CustomField.Name: </strong><span style="padding-left: 3px;">@customFieldValue.Value</span></li>
                                                        }
                                                    </ul>
                                                </td>
                                            </tr>
                                        }
                                    }

                                    @if (Model.Attachments != null && Model.Attachments.Any())
                                    {
                                        <tr>
                                            <td style="vertical-align: top; text-align: left; margin: 0; padding: 0 0 10px;" align="center" valign="top">
                                                <span style="font-weight: bold; color: #2e4592; margin: 0;">Files </span>
                                                <ul style="padding: 0 0 0 17px; margin: 0; list-style: none;">
                                                    @foreach (var file in Model.Attachments)
                                                    {
                                                        <li>
                                                            <a style="display: inline-block; line-height: 18px; margin-bottom: 10px; color: #1c7deb;" class="file-attachments" href="@Url.Action("GetFile", "File", new { Id = Model.Ticket.TicketId, FileName = file.Name })" target="_blank"><i class="fa fa-file fa-align-left"></i> @file.Name</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
            <td style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0;" valign="top"></td>
        </tr>
    </table>
</body>
</html>