@using TicketDesk.Localization.Client
@using TicketDesk.Web.Client.Infrastructure.Helpers
@model TicketDesk.Web.Client.Models.IdUploaderViewModel

@section title { ID Uploader }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
    <link href="~/src/css/custom-dropzone.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/dropzone/dropzone.min.js"></script>
    <script src="~/src/js/ticket-dropzone.js"></script>

    <script src="~/src/js/formhandler.js"></script>
}

<!-- Modal -->
<div id="notification-modal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">@Resources.Views_IdUploader_UploadSuccess</h4>
            </div>
            <div class="modal-body">
                <p>@Resources.Views_IdUploader_InformationSavedSuccessfully</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">@Resources.Dropzone_Modal_Close</button>
            </div>
        </div>

    </div>
</div>

@using (Html.BeginForm("NewCustomer", "IdUploader", null, FormMethod.Post, new { @class = "form-horizontal id-uploader-form filechange", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.TempId)

    <div class="form-content feedback-form">
        <div class="title">@Resources.Views_IdUploader_Form_Title</div>
        <div class="item-list item">
            @Html.RequiredLabelFor(x => x.CustomerUserName, new { @class = "key fullwidth border" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.CustomerUserName)
                @Html.ValidationMessageFor(x => x.CustomerUserName)
            </div>
        </div>
        <div class="item-list item">
            @Html.RequiredLabelFor(x => x.CustomerName, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.CustomerName)
                @Html.ValidationMessageFor(x => x.CustomerName)
            </div>
        </div>
        <div class="item-list item">
            @Html.RequiredLabelFor(x => x.IdNumber, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @*@Html.TextBoxFor(x => x.IdNumber, new {@class="skip-limit"})*@
                @Html.TextBoxFor(x => x.IdNumber, new {@class="skip-limit"})
                @Html.ValidationMessageFor(x => x.IdNumber)
            </div>
        </div>
        <div class="item-list item">
            @Html.RequiredLabelFor(x => x.Remark, new { @class = "key fullwidth" })
            @*@{
                var max = AttributeHelper.GetPropertyAttributeValue<IdUploaderViewModel, string, StringLengthAttribute, int>(prop => prop.Remark, attr => attr.MaximumLength);
            }
            <span class="highlight">(@max @Resources.Common_Form_Characters)</span>*@
            <div class="fullwidth">
                @Html.TextAreaFor(x => x.Remark)
                @Html.ValidationMessageFor(x => x.Remark)
            </div>
        </div>
        @Html.Partial("_DropzoneView", Model)
    </div>
    <input type="submit" class="btn btn-primary btn-send" value="@Resources.Common_Form_Send" />
}