@model TicketDesk.Web.Client.Models.IdUploaderViewModel

@section title { ID Uploader }

@section css
{
    <link href="~/src/libs/dropzone/dropzone.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/dropzone/dropzone.min.js"></script>
    @Html.Partial("_DropzoneScripts", Model)
}

@using (Html.BeginForm("NewCustomer", "IdUploader", null, FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-content feedback-form">
        <div class="title">ID UPLOADER FORM</div>
        <div class="item-list item">
            @Html.LabelFor(x => x.CustomerUserName, new { @class = "key fullwidth border" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.CustomerUserName)
                @Html.ValidationMessageFor(x => x.CustomerUserName)
            </div>
        </div>
        <div class="item-list item">
            @Html.LabelFor(x => x.CustomerName, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.CustomerName)
                @Html.ValidationMessageFor(x => x.CustomerName)
            </div>
        </div>
        <div class="item-list item">
            @Html.LabelFor(x => x.IdNumber, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.TextBoxFor(x => x.IdNumber)
                @Html.ValidationMessageFor(x => x.IdNumber)
            </div>
        </div>
        <div class="item-list item">
            @Html.LabelFor(x => x.Remark, new { @class = "key fullwidth" })
            <div class="fullwidth">
                @Html.TextAreaFor(x => x.Remark)
            </div>
        </div>
        <div class="attach-file">
            <div class="key border">Attach files*:</div>
            <div class="value span-3 border">
                <button type="button" id="add-file-btn">Add files</button>

                <p class="dropzone-error-text"></p>

                <div class="dropzone-previews"></div>
            </div>
            <div class="fullwidth bold border"><span class="highlight">*</span>Max number of attachments: <span class="highlight">@Model.MaxNumberOfFile Files</span> | Max total size of attachments: <span class="highlight">@(Model.MaxBytes / 1048576) MB</span> | Allowed file types: <span class="highlight">@string.Join(", ", Model.AcceptedExtensions)</span></div>
        </div>
    </div>
    <input type="submit" class="btn btn-send" value="Send"/>
}