@using TicketDesk.Localization.Client
@{
    ViewBag.Title = "InternalError";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Internal Error</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    @Styles.Render("~/content/error-pages")
    <style>
        body {
            font-family: Roboto, sans-serif;
            margin: 0;
        }

        .layout-full {
            position: relative;
            padding: 100px calc(50% - 300px);
            height: 100%;
            text-align: center;
            overflow: hidden;            
        }

        .layout-full .img-wrap {
            margin-bottom: 40px;
        }

        .layout-full .title {   
            margin-top: 0;         
            color: #bf141a;
            font-size: 18px;
            font-weight: normal;
        }

        .layout-full .big-title {
            font-size: 50px;
            color: #bf141a;
            margin: 0;
        }

        .layout-full .cta-button {
            text-decoration: none;
            color: #fff;
            display: inline-block;
            padding: 10px 20px;
            border-radius: 40px;
            background: #2e4592;
            transition: .2s ease all;
        }

        .layout-full .cta-button:hover, .layout-full .cta-button:focus {
            background: #3955b3;
        }
    </style>
</head>
<body>

    <div class="layout-full">
        <div class="img-wrap">
            <img src="~/src/contents/images/error-assets/img500.png" />
        </div>

        <h2 class="big-title">500</h2>
        <h2 class="title">@Resources.Views_Home_Error_Title</h2>
        @*<p class="text margin-bottom-0">@Resources.Views_Home_Error_Text</p>
            <p class="text">@Resources.Views_Home_Error_Text2</p>*@
        <a class="cta-button" href="~/"><i class="icon fa fa-arrow-left"></i>@Resources.Views_Home_AccessDenied_ActionText</a>
    </div>
</body>
</html>