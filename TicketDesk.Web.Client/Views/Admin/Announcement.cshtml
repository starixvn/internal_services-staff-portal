@using TicketDesk.Domain.Model
@model TicketDesk.Web.Client.Models.Admin.AnnouncementViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section title{ Annoucement }

@using (Html.BeginForm("Announcement", "Admin", FormMethod.Get, new { @class = "form-inline" }))
{
    <div class="form-group">
        @Html.LabelFor(x => x.FromDate)
        @Html.TextBoxFor(x => x.FromDate, new { @class = "form-control text-primary", type="date" })
    </div>

    <div class="form-group">
        @Html.LabelFor(x => x.ToDate)
        @Html.TextBoxFor(x => x.ToDate, new { @class = "form-control text-primary", type = "date" })
    </div>

    <div class="form-group">
        @Html.LabelFor(x => x.Status)
        @Html.EnumDropDownListFor(x => x.Status, new { @class = "form-control text-primary" })
    </div>

    <div class="form-group">
        @Html.LabelFor(x => x.State)
        @Html.EnumDropDownListFor(x => x.State, new { @class = "form-control text-primary" })
    </div>

    <button type="submit" class="btn btn-success">Submit</button>
}

<div class="row">
    <table>
        @foreach (Announcement announcement in Model.Announcements)
        {
            <tr>
                <td>@announcement.Id</td>
            </tr>
        }
    </table>
</div>