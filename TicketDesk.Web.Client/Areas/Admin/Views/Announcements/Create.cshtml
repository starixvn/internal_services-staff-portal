@using TicketDesk.Web.Client.Infrastructure.Helpers
@model TicketDesk.Web.Client.Areas.Admin.Models.Announcements.NewAnnouncementViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Create</h2>

@using (Html.BeginForm("Create", "Announcements", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Announcement</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        
        <div class="form-group">
            @Html.LabelFor(model => model.IsImportant, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.CheckBoxFor(model => model.IsImportant, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.RequiredLabelFor(model => model.Announcement.Message, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Announcement.Message, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Announcement.Message, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Announcement.PublishedDateTime, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.Announcement.PublishedDateTime, new {  @class = "form-control", type = "date-local" })
                @Html.ValidationMessageFor(model => model.Announcement.PublishedDateTime, "", new { @class = "text-danger" })
            </div>
        </div>

        <button class="btn btn-default">Get Current Date/Time</button>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}