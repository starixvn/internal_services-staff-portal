@using TicketDesk.Domain
@using TicketDesk.Domain.Model
@using TicketDesk.Web.Client.Areas.Admin.Models.Announcements
@model AnnouncementViewModel

@{
    ViewBag.Title = "Announcements Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="page-title">@ViewBag.Title</h2>

@section css
{
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.js"></script>
    <script src="~/src/js/admin/announcement/announcementsindex.js"></script>
}

<div id="announcement-modal">
    <!--edit announcement modal place holder-->
</div>

<!--Filter-->
<section class="filter-form">
    @using (Html.BeginForm("Index", "Announcements", FormMethod.Get, new { @class = "row" }))
    {
        <div class="form-group col-lg-2 col-md-3 col-xs-4">
            @Html.LabelFor(x => x.PublishedFrom)
            <div class="date-time">
                @Html.TextBoxFor(x => x.PublishedFrom, new { @class = "datetimepicker form-control" })
                <span class="icon-calendar"></span>
            </div>
        </div>
        <div class="form-group col-lg-2 col-md-3 col-xs-4">
            @Html.LabelFor(x => x.PublishedTo)
            <div class="date-time">
                @Html.TextBoxFor(x => x.PublishedTo, new { @class = "datetimepicker form-control" })
                <span class="icon-calendar"></span>
            </div>
        </div>
        <div class="form-group col-lg-2  col-md-3col-xs-4">
            @Html.LabelFor(x => x.Status)
            @Html.EnumDropDownListFor(x => x.Status, "All", new { @class = "form-control" })
        </div>
        <div class="form-group col-lg-2 col-md-3 col-xs-4">
            @Html.LabelFor(x => x.State)
            @Html.EnumDropDownListFor(x => x.State, "All", new { @class = "form-control" })
        </div>

        <div class="button-filter col-lg-2 col-md-3 col-xs-4 ">
            <button type="submit" class="btn btn-submit">Submit</button>
        </div>
    }
</section>

<div class="button-group">
    <a class="btn btn-create create"
       data-toggle="modal"
       href="#"
       data-href="@Url.Action("Create", "Announcements")"
       data-modalid="#@ModalId.CreateAnnouncementModal.ToString()"><span class="icon-add"></span>@ModalId.CreateAnnouncementModal.GetDisplayName()</a>
</div>

<!--Table-->
<section class="table">
    @using (Html.BeginForm("Publish", "Announcements", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @*@Html.Partial("_Publish")*@

        <table class="announcement-list">
            <tr>
                <th>#</th>
                <th>ID</th>
                <th class="width-150">Last Modified</th>
                <th class="width-120">Modified By</th>
                <th class="width-150">Published Date</th>
                <th>Announcement</th>
                <th>Status</th>
                <th class="publish">
                    <button class="btn btn-publish" disabled="disabled" type="button" data-toggle="modal" data-target="#publish-announcement-confirm-modal">Publish</button>
                </th>
                <th class="action">Action</th>
            </tr>

            @if (Model.Announcements != null)
                {
                    var count = Model.Announcements.Count;
                    for (var index = 0; index < count; index++)
                    {
                        var item = Model.Announcements[index];

                    <tr>
                        <td class="text-center">@(index + 1)</td>
                        <td class="text-center">@item.Id</td>
                        <td>@item.LastModified</td>
                        <td>@item.ModifiedBy</td>
                        <td>@item.PublishedDateTime</td>
                        <td>@item.Message</td>
                        <td class="text-center">@item.Status</td>
                        <td class="text-center">
                            @if (item.State == AnnouncementState.Published)
                        {
                                <span class="icon-check"></span>
                            }
                            else
                            {
                                <div class="checkbox">
                                    <!--Use Html.NameFor in Id for CSS styling-->
                                    <input type="checkbox"
                                           id="@Html.NameFor(x => x.Announcements[index].IsWaitingToPublish)"
                                           name="@Html.NameFor(x => x.Announcements[index].IsWaitingToPublish)"
                                           value="true" />
                                    <label for="@Html.NameFor(x => x.Announcements[index].IsWaitingToPublish)"></label>
                                    @Html.HiddenFor(x => x.Announcements[index].Id)
                                </div>
                            }
                        </td>
                        <td>
                            @if (item.State == AnnouncementState.Scheduled)
                        {
                                <div class="dropdown action-group">
                                    <div class="dropdown-toggle" id="dropdownAction" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                        <span class="icon-setting" aria-hidden="true"></span>
                                        <span class="icon-arrow-down" aria-hidden="true"></span>
                                    </div>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownAction">
                                        <li>
                                            <a class="edit manual-modal-handler"
                                               data-action="@Url.Action("Edit", "Announcements", new { id = item.Id })"
                                               href="#"
                                               data-modalid="#@ModalId.EditAnnouncementModal.ToString()">
                                                <span class="icon-edit"></span><span>Edit</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="delete" href="#" data-href="@Url.Action("Delete","Announcements", new { id = item.Id })">
                                                <span class="icon-delete"></span><span>Delete</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
        </table>

        @Html.Partial("_Pagination", Model)
    }
</section>