@model TicketDesk.Web.Client.Areas.Admin.Models.Announcements.AnnouncementViewModel

@{
    ViewBag.Title = "Announcements Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>@ViewBag.Title</h2>

<a class="btn btn-primary" href="@Url.Action("Create","Announcements")">+ Create new Announcement</a>

<!--Filter-->
<section>
    @using (Html.BeginForm("Index", "Announcements", FormMethod.Get, new { @class = "form-inline" }))
    {
        <div class="input-group">
            @Html.LabelFor(x => x.PublishedFrom)
            @Html.TextBoxFor(x => x.PublishedFrom, new { type = "date", @class = "form-control" })
        </div>
        <div class="input-group">
            @Html.LabelFor(x => x.PublishedTo)
            @Html.TextBoxFor(x => x.PublishedTo, new { type = "date", @class = "form-control" })
        </div>
        <div class="input-group">
            @Html.LabelFor(x => x.Status)
            @Html.EnumDropDownListFor(x => x.Status, "All", new { @class = "form-control" })
        </div>
        <div class="input-group">
            @Html.LabelFor(x => x.State)
            @Html.EnumDropDownListFor(x => x.State, "All", new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
    }
</section>

<!--Table-->
<section>
    <table class="table">
        <tr>
            <th>#</th>
            <th>ID</th>
            <th>Last Modified</th>
            <th>Modified By</th>
            <th>Published Date</th>
            <th>Announcement</th>
            <th>Status</th>
            <th>Publish</th>
            <th>Action</th>
        </tr>

        @if (Model.Announcements != null)
        {
            foreach (var item in Model.Announcements)
            {
                <tr>
                    <td>0</td>
                    <td>@item.Id</td>
                    <td>@item.LastModified</td>
                    <td>@item.ModifiedBy</td>
                    <td>@item.PublishedDateTime</td>
                    <td>@item.Message</td>
                    <td>@item.Status</td>
                    <td>@item.State</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                    </td>
                </tr>
            }
        }
    </table>
    
    @Html.Partial("_Pagination", Model)
</section>