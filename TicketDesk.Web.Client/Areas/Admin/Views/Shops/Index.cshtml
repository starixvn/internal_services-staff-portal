    </table>
</section>


<!-- Create New Item -->
<div class="modal fade" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" id="createModal">
    <div class="modal-dialog small-modal" role="document">
        <div class="modal-content -has-title" id="createModalContent">
        </div>
    </div>
</div>

<!-- Edit Item -->
<div class="modal fade" role="dialog" aria-labelledby="modalUpdateLabel" data-backdrop="static" id="editItemModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title" id="editItemModalContent">
        </div>
    </div>
</div>