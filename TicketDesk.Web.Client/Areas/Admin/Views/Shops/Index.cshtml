@using System.Web.Optimization
@model TicketDesk.Web.Client.Areas.Admin.Models.ShopManagement.ShopFilterViewModel

@{
    ViewBag.Title = "Shop Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    @Styles.Render("~/content/shop-management")
}

@section scripts
{
    @Scripts.Render("~/bundles/shop-management")
}

<h2 class="page-title">@ViewBag.Title</h2>

<section class="filter-form">
    @using (Html.BeginForm("Index", "ShopManagement", FormMethod.Get, new { @class = "filter-row" }))
    {
        <div class="text-field">
            @Html.LabelFor(x => x.ShopName)
            <div class="text-field">
                @Html.TextBoxFor(x => x.ShopName, new { @class = "form-control" })
                @Html.HiddenFor(x => x.ShopId, new { @class = "form-control" })
            </div>
        </div>

        <div class="dropdown-small">
            @Html.LabelFor(x => x.IsActive)
            @Html.EnumDropDownListFor(x => x.IsActive, new { @class = "form-control" })
        </div>

        <div class="button-filter">
            <button type="submit" class="btn btn-submit">Submit</button>
        </div>
    }
</section>

<div class="table-actions">
    <a class="btn btn-create create"><span class="icon-add"></span>Create New Shop</a>
</div>

<section class="table">
    <table class="announcement-list" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th class="number">#</th>
                <th class="shop-name">
                    <span>Shop Name</span>
                </th>
                <th class="shop-code">
                    <span>Shop Code</span>
                </th>
                <th class="email-address">
                    <span>Email Address</span>
                </th>
                <th class="phone">
                    <span>Contact Number</span>
                </th>
                <th class="shop-address">
                    <span>Shop Address</span>
                </th>
                <th class="active">Active</th>                
                <th class="action">Edit</th>
            </tr>
        </thead>
