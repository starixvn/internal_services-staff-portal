@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Areas.Admin.Models.DataConfiguration.ListCustomFieldListValueViewModel

<div class="table-actions">
    <a class="btn btn-create create" href="@Url.Action("AddCustomFieldListValue", "DataConfiguration", new {customFieldId = Model.SelectedFieldId, modalTitle = Model.ModalTitle})">
        <span class="icon-add"></span>@Resources.CreateNewItem
    </a>
</div>

<table class="announcement-list" cellpadding="0" cellspacing="0">
    <thead>
        <tr>
            <th class="number">#</th>
            <th class="name-vn">
                <span>@Resources.DisplayNameVI</span>
            </th>
            <th class="name-en">
                <span>@Resources.DisplayNameEN</span>
            </th>
            <th class="description">
                <span>@Resources.Description</span>
            </th>
            <th class="active">@Resources.Active</th>
            <th class="action">@Resources.Edit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customFieldListValue in Model.CustomFieldListValues)
        {
            <tr>
                <td>1</td>
                <td>@customFieldListValue.DisplayName_vi</td>
                <td>@customFieldListValue.DisplayName</td>
                <td>@customFieldListValue.Description</td>
                <td>
                    @if (customFieldListValue.IsActive)
                    {
                        <span class="icon-check"></span>
                    }
                </td>
                <td><span class="icon-edit"></span></td>
            </tr>
        }
    </tbody>
</table>