@using TicketDesk.Localization.Client
@using TicketDesk.Web.Client.Infrastructure.Helpers
@model TicketDesk.Domain.Model.CustomFieldListValue

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static">
    <div class="modal-dialog small-modal" role="document">
        @using (Html.BeginForm("EditCustomFieldListvalue", "DataConfiguration", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.CustomFieldId)

            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <!--TODO: Localization from Database here-->
                    <h4 class="modal-title" id="myModalLabel">@Resources.DataConfigurationEditItemTitle"@Model.DisplayName_vi"</h4>
                </div>
                <div class="modal-body">
                    <div class="form">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.RequiredLabelFor(model => model.DisplayName_vi, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.DisplayName_vi, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.DisplayName_vi, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DisplayName, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.DisplayName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.DisplayName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group checkbox">
                            @if (Model.IsActive)
                            {
                                <input type="checkbox"
                                       id="@Html.NameFor(x => x.IsActive)"
                                       name="@Html.NameFor(x => x.IsActive)"
                                       value="true"
                                       checked="checked" />
                            }
                            else
                            {
                                <input type="checkbox"
                                       id="@Html.NameFor(x => x.IsActive)"
                                       name="@Html.NameFor(x => x.IsActive)"
                                       value="true" />
                            }
                            @Html.LabelFor(model => model.IsActive)
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">@Resources.Cancel</button>
                    <button type="submit" class="btn btn-submit" data-type="edit">@Resources.Save</button>
                </div>
            </div>
        }
    </div>
</div>
