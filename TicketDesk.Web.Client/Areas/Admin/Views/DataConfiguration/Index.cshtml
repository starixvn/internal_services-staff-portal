@using TicketDesk.Domain.Model
@model TicketDesk.Web.Client.Areas.Admin.Models.DataConfiguration.DataConfigurationViewModel

@{
    ViewBag.Title = "Data Configuration";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section scripts
{
    <script src="~/src/js/admin/dataconfiguration/dataconfigurationindex.js" type="text/javascript"></script>
}

<div id="dynamic-modals"></div>

<h2 class="page-title">@ViewBag.Title</h2>

<section class="filter-form">
    @using (Html.BeginForm("Index", "DataConfiguration", FormMethod.Get, new { @class = "filter-row" }))
    {
        <div class="select-group">
            @Html.LabelFor(x => x.SelectedFieldId)
            <div class="select-group">
                <select class="form-control" id="@Html.IdFor(x => x.SelectedFieldId)" name="@Html.NameFor(x => x.SelectedFieldId)">
                    @foreach (var editableField in Model.EditableCustomFields)
                    {
                        if (editableField.CustomFieldId == Model.SelectedFieldId)
                        {
                            <option selected="selected" value="@editableField.CustomFieldId">@editableField.Name</option>
                        }
                        else
                        {
                            <option value="@editableField.CustomFieldId">@editableField.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="button-filter">
            <button type="submit" class="btn btn-submit">Submit</button>
        </div>
    }
</section>

<div class="table-actions">
    <a class="btn btn-create create"><span class="icon-add"></span>Create new Item</a>
</div>

<section class="table">
    <table class="announcement-list" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th class="number">#</th>
                <th class="name-vn">
                    <span>@nameof(CustomFieldListValue.DisplayName_vi)</span>
                </th>
                <th class="name-en">
                    <span>@nameof(CustomFieldListValue.DisplayName)</span>
                </th>
                <th class="description">
                    <span>@nameof(CustomFieldListValue.Description)</span>
                </th>
                <th class="active">@nameof(CustomFieldListValue.IsActive)</th>
                <th class="action">Edit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customFieldListValue in Model.CustomFieldListValues)
            {
                <tr>
                    <td>1</td>
                    <td>@customFieldListValue.DisplayName_vi</td>
                    <td>@customFieldListValue.DisplayName</td>
                    <td>@customFieldListValue.Description</td>
                    <td>
                        @if (customFieldListValue.IsActive)
                        {
                            <span class="icon-check"></span>
                        }
                    </td>
                    <td><span class="icon-edit"></span></td>
                </tr>
            }
        </tbody>
    </table>
</section>