@using System.Web.Optimization

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="msapplication-config" content="none" />
    <link rel="shortcut icon" type="image/x-icon" href="~/src/contents/images/favicon.png" />
    <title>Admin - @ViewBag.Title</title>

    <link href="~/src/libs/normalize.css" rel="stylesheet" />
    <link href="~/src/libs/select2/select2.min.css" rel="stylesheet" />
    <link href="~/src/libs/bootstrap-3.3.7/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/src/libs/rippler/css/rippler.min.css" rel="stylesheet" />
    <link href="~/src/Fonts/iconFont/style.css" rel="stylesheet" />
    <link href="~/src/libs/toastr/toastr.css" rel="stylesheet" />
    @RenderSection("css", required: false)
    <link href="~/src/css/admin/admin-site.css" rel="stylesheet" />

    @RenderSection("customHeader", required: false)
</head>

    @Html.Action("Menu", "Home")

    <main>
        <div class="body-content">
            @RenderBody()
        </div>
    </main>

    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>

    <!-- Include all compiled plugins (below), or include individual files as needed -->

    <script src="~/src/libs/bootstrap-3.3.7/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/src/libs/Touch/touche.js" type="text/javascript"></script>
    <script src="~/src/libs/rippler/js/jquery.rippler.min.js" type="text/javascript"></script>
    <script src="~/src/libs/toastr/toastr.js" type="text/javascript"></script>
    <script src="~/src/libs/select2/select2.min.js" type="text/javascript"></script>

    @*<script src="~/Scripts/globalize.js" type="text/javascript"></script>*@
    <script src="~/Scripts/ticketdesk/common.js" type="text/javascript"></script>
    <script src="~/src/libs/jquery.floatThead/jquery.floatThead.js" type="text/javascript"></script>
    <script src="~/src/js/admin/common.js" type="text/javascript"></script>

    @Scripts.Render("~/bundles/validate")

    <!--To remove date check-->

    <script>
        jQuery.validator.methods["date"] = function (value, element) { return true; }
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>