@using TicketDesk.Core.Resources
@using TicketDesk.Web.Client.Infrastructure.Extensions
@model TicketDesk.Web.Client.Models.NavbarViewModel

<!-- Modal confirm logout -->
<div class="modal fade" id="logOut" role="dialog">
    <div class="modal-dialog small-modal">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">@Messages.LogoutConfirmation</h4>
            </div>
            <div class="modal-body">
                <p>@Messages.LogoutModalDescription</p>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary rippler rippler-default" id="confirmLogOut">@Messages.Yes</button>
                <button type="button" class="btn btn-second rippler rippler-default" data-dismiss="modal">@Messages.No</button>
            </div>
        </div>
    </div>
</div>

<nav class="header fixed-top">
    <div class="navbar-brand-wrapper">
        <a href="#"><img src="~/src/contents/images/logo.svg" class="img-logo"/></a>
    </div>
    <div class="navbar-menu-wrapper">
        <span class="icon-menu"></span>
        <ul class="nav navbar-nav navbar-right">
            <li class="user-info"></li>
        </ul>
    </div>
</nav>

<section class="body-content">
    <nav class="sidebar">
        <ul>
            @foreach (var menu in Model.MenuItems)
            {
                var menuLink = "#";
                if (!string.IsNullOrEmpty(menu.Url))
                {
                    menuLink = menu.Url;
                }

                var menuClass = Html.IsActiveRoute(menuLink);

                <li class="@menuClass">
                    <a href="@menuLink" class="menu-item"><i class="@menu.IconClass"></i><span class="text">@menu.Name</span></a>
                    @if (menu.Children != null && menu.Children.Any())
                {
                        <ul>
                            @foreach (var childMenu in menu.Children)
                            {
                                <a href="@childMenu.Url" class="menu-item"><i class="@childMenu.IconClass"></i><span class="text">@childMenu.Name</span></a>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    </nav>
</section>

