@using TicketDesk.Domain.Model
@using TicketDesk.Core.Enumerations
@using TicketDesk.Localization.Client
@model Reference

<li class="reference-entry">
    @if (Model.ReferenceType != ReferenceType.Newsletters)
    {
        <div class="date form-group">
            @Html.LabelFor(model => model.DateAppear)
            <span class="text-red">*</span>
            <div class="datetime-field">
                @Html.TextBoxFor(model => model.DateAppear, new { @class = "datetimepicker form-control" })
                <span class="icon-calendar"></span>
                @Html.ValidationMessageFor(model => model.DateAppear, string.Empty, new { @class = "error-message" })
            </div>
        </div>

    }
    <div class="url form-group">
        @Html.LabelFor(model => model.ImageLink)
        <span class="text-red">*</span>
        @Html.TextBoxFor(model => model.ImageLink, new { maxLength = 500, @class = "form-control image-url" })
        @Html.ValidationMessageFor(model => model.ImageLink, string.Empty, new { @class = "error-message" })
        <span class="error-message upload-image-validation"></span>
    </div>

    <div class="browse form-group">
        <div class="btn btn-browse">
            <span>@Resources.Dropzone_Form_Browse</span>
            <input class="upload-image" type="file" accept=".jpg, .jpeg, .png" id="imageUpload" data-href="@Url.Action("UploadImage", "References")" data-limit="50">
        </div>
        <input type="button" class="btn btn-delete remove-entry" value="@Resources.Delete">
    </div>
</li>