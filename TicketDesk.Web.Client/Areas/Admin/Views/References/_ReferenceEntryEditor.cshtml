@using TicketDesk.Web.Client.Areas.Admin.Models.References
@using TicketDesk.Core.Enumerations
@model ReferenceViewModel

<li class="reference-entry">
    @if (Model.ReferenceType != ReferenceType.NewsLetter)
    {
        <div class="col-xs-4">
            @Html.LabelFor(model => model.DateAppear)
            @Html.TextBoxFor(model => model.DateAppear, new { @class = "datetimepicker form-control" })
            @Html.ValidationMessageFor(model => model.DateAppear)
        </div>

    }
    <div class="col-xs-4">
        @Html.LabelFor(model => model.ImageLink)
        @Html.TextBoxFor(model => model.ImageLink, new { @class = "form-control image-url" })
        @Html.ValidationMessageFor(model => model.ImageLink)
    </div>

    <div class="col-xs-4" style="margin-top: 25px">
        <input class="upload-image" type="file" accept=".jpg, .jpeg, .png" style="display: inline-block">
        <input type="button" class="btn btn-danger remove-entry" value="Delete">
    </div>
</li>