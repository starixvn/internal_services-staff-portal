@using TicketDesk.Web.Client.Areas.Admin.Models.References
@model ListReferencesViewModel

@{
    ViewBag.Title = "Newsletter";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
}

<h2 class="page-title">Newsletters</h2>

<div class="upload-info">
    <span>Allowed file type: <strong>jpeg, jpg, png</strong></span> |
    <span>Maximum file size: <strong>2MB/file</strong></span> |
    <span>Maximum number of upload files: <strong>50 files</strong></span>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div>
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <ul class="references-zone" id="ReferencesZone">
            @for (var i = 0; i < Model.References.Count(); i++)
            {
                <li class="reference-entry">
                    <div class="url form-group">
                        @Html.LabelFor(model => model.References[i].ImageLink)
                        <span class="text-red">*</span>
                        @Html.TextBoxFor(model => model.References[i].ImageLink, new { @class = "form-control image-url" })
                        <span class="text-red upload-image-validation"></span>
                        @Html.ValidationMessageFor(model => model.References[i].ImageLink)
                    </div>

                    <div class="browse form-group">
                        <div class="btn btn-browse">
                            <span>Browse...</span>
                            <input class="upload-image" type="file" accept=".jpg, .jpeg, .png" id="excelFile">
                        </div>
                        <input type="button" class="btn btn-delete remove-entry" value="Delete">
                    </div>
                </li>
            }
        </ul>

        <div class="button-group">
            <input type="button" id="addReferenceEntry" value="+ Add Image" class="btn btn-create" data-type="newsLetter" />
            <input type="submit" id="submit" value="Submit" class="btn btn-submit" />
        </div>
    </div>
}

@section scripts {
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.js"></script>
    <script src="~/src/js/admin/reference/reference.js"></script>

}