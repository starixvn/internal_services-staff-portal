@using System.Web.Optimization
@using TicketDesk.Web.Client.Areas.Admin.Models.References
@using TicketDesk.Core.Resources

@model ListReferencesViewModel

@{
    ViewBag.Title = ViewLang.FeaturedEvents;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    @Styles.Render("~/content/reference-admin")
}

<h2 class="page-title">Feature Events</h2>
@using (Ajax.BeginForm("FeatureEvents", "References",
                new AjaxOptions
                {
                    OnSuccess = "ajaxSubmitReference.onSuccess",
                    OnFailure = "ajaxSubmitReference.onFailure"
                }))
{
    @Html.Partial("_ReferenceCommon", Model)
}

@section scripts {
    @Scripts.Render("~/bundles/reference-admin")

}