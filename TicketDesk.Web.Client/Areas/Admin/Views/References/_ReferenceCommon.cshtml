@using TicketDesk.Web.Client.Areas.Admin.Models.References
@model ListReferencesViewModel

@Html.AntiForgeryToken()

<div class="upload-info">
    <span>Alowed file type: <strong>jpeg, jpg, png</strong></span> |
    <span>Maximum file size: <strong>2MB/file</strong></span> |
    <span>Maximum number of upload files: <strong>31 files</strong></span>
</div>

<div>
    @if (TempData["Success"] != null)
    {
        <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
    }
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <ul class="references-zone" id="ReferencesZone">
        @if (Model.References.Count() > 0)
        {
            @for (var i = 0; i < Model.References.Count(); i++)
            {
                <li class="reference-entry">
                    <div class="date form-group">
                        @Html.LabelFor(model => model.References[i].DateAppear)
                        <span class="text-red">*</span>
                        @Html.TextBoxFor(model => model.References[i].DateAppear, new { @class = "datetimepicker form-control" })
                        <span class="icon-calendar"></span>
                        @Html.ValidationMessageFor(model => model.References[i].DateAppear)
                    </div>

                    <div class="url form-group">
                        @Html.LabelFor(model => model.References[i].ImageLink)
                        <span class="text-red">*</span>
                        @Html.TextBoxFor(model => model.References[i].ImageLink, new { @class = "form-control image-url" })
                        <span class="text-red upload-image-validation"></span>
                        @Html.ValidationMessageFor(model => model.References[i].ImageLink)
                    </div>

                    <div class="browse form-group">
                        <div class="btn btn-browse">
                            <span>Browse...</span>
                            <input class="upload-image" type="file" accept=".jpg, .jpeg, .png" id="excelFile">
                        </div>
                        <input type="button" class="btn btn-delete remove-entry" value="Delete">
                    </div>
                </li>
            }
        }
        
    </ul>

    <div class="button-group">
        <input type="button" id="addReferenceEntry" value="+ Add Image" class="btn btn-create" />
        <input type="submit" value="Submit" class="btn btn-submit" onclick="CleanLeavePage();"/>
    </div>
</div>