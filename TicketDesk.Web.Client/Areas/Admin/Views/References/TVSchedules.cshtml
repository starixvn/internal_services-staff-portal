@using TicketDesk.Web.Client.Areas.Admin.Models.References
@model ListReferencesViewModel

@{
    ViewBag.Title = "TVSchedules";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
}

<h2>TVSchedules</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Reference</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <ul id="AddImageZone">
            @foreach (var tvSchedule in Model.References)
            {
                Html.RenderPartial("_ReferenceEntryEditor", tvSchedule);
            }
        </ul>

        <div class="form-group">
            <div class="col-md-3">
                <input type="button" id="AddImage" value="Add Image" class="btn btn-success" />
            </div>
            <div class="col-md-3">
                <input type="submit" value="Submit" class="btn btn-primary" />
            </div>
            <div class="col-md-6">
                <p>Alowed file type: jpeg, jpg, png</p>
                <p>Maximum file size: 2MB/file</p>
                <p>Maximum number of upload files: 31 files</p>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="~/Scripts/reference/reference.js"></script>
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.datetimepicker').datetimepicker({
                format: 'DD/MM/YYYY hh:mm',
                defaultDate: new Date(),
                maxDate: new Date(),
                sideBySide: true
            });
        });
    </script>
}
