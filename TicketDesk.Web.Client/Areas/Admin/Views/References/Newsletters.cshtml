@using System.Web.Optimization
@using TicketDesk.Localization.Client
@using TicketDesk.Web.Client.Areas.Admin.Models.References
@using TicketDesk.Core.Resources

@model ReferencesViewModel

@{
    ViewBag.Title = ViewLang.NewsLetters;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    @Styles.Render("~/content/reference-admin")
}

@section scripts {
    @Scripts.Render("~/bundles/reference-admin")
}

<h2 class="page-title">@ViewLang.NewsLetters</h2>

<div class="upload-info">
    <span>Allowed file type: <strong>jpeg, jpg, png</strong></span> |
    <span>Maximum file size: <strong>2MB/file</strong></span> |
    <span>Maximum number of upload files: <strong>50 files</strong></span> |
    <span>Minimum image size: <strong>600x400px</strong></span>
</div>

@using (Html.BeginForm("UploadReferences", "References", new { referenceType = Model.Type }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(x => x.Type, new { @readonly = "readonly" })
        <ul class="references-zone" id="ReferencesZone">
            @for (var i = 0; i < Model.References.Count(); i++)
                {
                <li class="reference-entry">
                    <div class="url form-group">
                        @Html.LabelFor(model => model.References[i].ImageLink)
                        <span class="text-red">*</span>
                        @if (Model.IsHostPermission)
                        {
                            @Html.TextBoxFor(model => model.References[i].ImageLink, new { @class = "form-control image-url" })
                        }
                        else
                        {
                            @Html.TextBoxFor(model => model.References[i].ImageLink, new { @class = "form-control image-url", @readonly = "readonly" })
                        }
                        @Html.ValidationMessageFor(model => model.References[i].ImageLink, string.Empty, new { @class = "text-red" })
                        <span class="text-red upload-image-validation"></span>
                    </div>

                    @Html.TextBoxFor(model => model.References[i].Id, new { @class = "hidden reference-id" })
                    @if (Model.IsHostPermission)
                    {
                        <div class="browse form-group">
                            <div class="btn btn-browse">
                                <span>@Resources.Dropzone_Form_Browse</span>
                                <input class="upload-image" type="file" accept=".jpg, .jpeg, .png" id="excelFile" data-href="@Url.Action("UploadImage", "References")">
                            </div>
                            <input type="button" class="btn btn-delete remove-entry" value="@Resources.Delete">
                        </div>
                    }
                </li>
            }
        </ul>

        <p class="text-red" id="limitEntry"></p>
        @if (Model.IsHostPermission)
        {
            <div class="button-group">
                <input type="button" id="addReferenceEntry" value="+ Add Image" class="btn btn-create" data-limit="50" data-href="@Url.Action("GetReferenceEntity", "References", new { isNewsletters = true})" />
                <input type="submit" id="submit" value="@Resources.Views_Announcement_Submit" class="btn btn-submit" />
            </div>
        }
    </div>
}