@using TicketDesk.Criteria.TicketList
@using TicketDesk.Domain.Extensions
@using TicketDesk.Localization.Domain
@using TicketDesk.Localization.Client
@model IEnumerable<TicketViewModel>

<table class="data-table dataTable no-footer" id="ticket-table">
    <thead>
        <tr>
            <th class="number">#</th>
            <th>@Resources.ID</th>
            <th>@Resources.Domain_Model_Ticket_Title</th>
            <th>@Resources.TicketCategory</th>
            <th>@Resources.ShopName</th>
            <th>@Resources.Domain_Model_Ticket_CreatedDate</th>
            <th>@Strings.TicketCreatedBy</th>
            <th>@Resources.Domain_Model_Ticket_Status</th>
        </tr>
    </thead>
    <tbody>
        @{
            var index = 0;
        }
        @foreach (var ticket in Model)
            {
                index++;
            <tr>
                <td class="text-center">@index</td>
                <td class="text-center">
                    <a href="@Url.Action("TicketDetails", "TicketList", new { id = ticket.Id })" , class="ticket-details">@ticket.Id</a>
                </td>
                <td>
                    @Html.ActionLink(ticket.Subject, "TicketDetails", "TicketList", new { id = ticket.Id }, new { @class = "ticket-details" })
                </td>
                <td>@ticket.TicketType.GetDisplayName()</td>
                <td>@ticket.ShopName</td>
                <td>@ticket.CreatedDate.UtcDateTime</td>
                <td>@ticket.CreatedBy</td>
                <td>
                    @if (ticket.IsHostPermissionOnTicketType)
                    {
                        @Html.EnumDropDownListFor(x => ticket.Status, new { @class = "form-control ticket-status", data_href = Url.Action("UpdateTicketStatus", "TicketList", new { id = ticket.Id }), id = ticket.Id })
                    }
                    else
                    {
                        <span>@ticket.Status</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>