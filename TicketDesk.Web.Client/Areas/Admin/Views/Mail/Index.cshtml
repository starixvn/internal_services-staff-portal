@model TicketDesk.Web.Client.Areas.Admin.Models.Mail.MailViewModel

@{
    ViewBag.Title = "Mail Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    <link rel="stylesheet" href="~/src/libs/bootstrap-tagsinput/bootstrap-tagsinput.css" />
}

@section scripts
{
    <script src="~/src/libs/bootstrap-tagsinput/bootstrap-tagsinput.js"></script>
    <script src="~/src/js/admin/mail/mail.js"></script>
}

<h2 class="page-title">@ViewBag.Title</h2>

<section class="filter-form">
    @using (Html.BeginForm("ListMail", "Mail", FormMethod.Post, new { @class = "filter-row" }))
    {
        <div class="dropdown-medium">
            @Html.LabelFor(x => x.CategoryId)
            @Html.EnumDropDownListFor(x => x.CategoryId, new { @class = "form-control" })
        </div>
    }
</section>

<section class="table" id="data-list"></section>