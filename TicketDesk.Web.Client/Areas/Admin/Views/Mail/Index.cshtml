@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Areas.Admin.Models.Mail.MailViewModel

@{
    ViewBag.Title = "Mail Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    <link href="~/src/libs/jquery.DataTable/datatables.min.css" rel="stylesheet" />
    <link href="~/src/libs/jquery.DataTable/fixedHeader.dataTables.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/js/admin/mail/mail.js"></script>
}

<div id="dynamic-modals"></div>

<h2 class="page-title">@ViewBag.Title</h2>

<section class="filter-form">
    @using (Html.BeginForm("ListMail", "Mail", FormMethod.Post, new { @class = "filter-row" }))
    {
        <div class="select-group">
            @Html.LabelFor(x => x.CategoryId)
            <div class="select-group">
                @Html.DropDownListFor(x => x.CategoryId, Model.TicketCategories.Select(x => new SelectListItem { Text = x.Name, Value = x.CategoryId.ToString() }))
            </div>
        </div>

        <div class="button-filter">
            <button type="submit" class="btn btn-submit">@Resources.Submit</button>
        </div>
    }
</section>

<section class="table" id="data-list"></section>