@using TicketDesk.Localization.Client
@model TicketDesk.Domain.Model.TicketCategory

@using (Html.BeginForm("EditMailSettings", "Mail", FormMethod.Post))
{
    @Html.HiddenFor(x => x.CategoryId)
    <div class="form-group">
        @Html.LabelFor(x => x.MailTo, new { @class = "control-label text-content" })
        <div class="text-content">
            @Html.TextBoxFor(x => x.MailTo, new { @class = "form-control tag" })
            @Html.ValidationMessageFor(x => x.MailTo, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(x => x.MailCcTo, new { @class = "control-label text-content" })
        <div class="text-content">
            @Html.TextBoxFor(x => x.MailCcTo, new { @class = "form-control tag" })
            @Html.ValidationMessageFor(x => x.MailCcTo, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(x => x.MailBccTo, new { @class = "control-label text-content" })
        <div class="text-content">
            @Html.TextBoxFor(x => x.MailBccTo, new { @class = "form-control tag" })
            @Html.ValidationMessageFor(x => x.MailBccTo, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group checkbox">
        @if (Model.IsAllowAdditionalMail)
        {
            <input type="checkbox"
                   id="@Html.IdFor(x => x.IsAllowAdditionalMail)"
                   name="@Html.NameFor(x => x.IsAllowAdditionalMail)"
                   value="true"
                   checked="checked" />
        }
        else
        {
            <input type="checkbox"
                   id="@Html.IdFor(x => x.IsAllowAdditionalMail)"
                   name="@Html.NameFor(x => x.IsAllowAdditionalMail)"
                   value="true" />
        }
        @Html.LabelFor(x => x.IsAllowAdditionalMail)
    </div>

    <button type="submit" class="btn btn-primary">@Resources.Save</button>
}