@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Areas.Admin.Models.CustomField.AddCustomFieldViewModel

<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static">
    <div class="modal-dialog data-modal" role="document">
        @using (Html.BeginForm("CreateCustomField", "CustomFields", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Create new custom field</h4>
                </div>
                <div class="modal-body">
                    <div class="form">

                        <div class="form-group">
                            @Html.LabelFor(x => x.TicketCategoryIds)
                            @Html.ListBoxFor(x => x.TicketCategoryIds, Model.TicketCategories, new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(x => x.CustomFieldTypeId)
                            @Html.DropDownListFor(x => x.CustomFieldTypeId, Model.CustomFieldTypes, new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Name_vi, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.Name_vi, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name_vi, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Values_vi, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.Values_vi, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Values_vi, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Values, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.Values, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Values, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group checkbox">
                            <input type="checkbox"
                                   id="@Html.NameFor(x => x.IsRequired)"
                                   name="@Html.NameFor(x => x.IsRequired)"
                                   value="true"
                                   checked="checked" />
                            @Html.LabelFor(model => model.IsRequired)
                        </div>

                        <div class="form-group checkbox">
                            <input type="checkbox"
                                   id="@Html.NameFor(x => x.IsAllowedToEditListValue)"
                                   name="@Html.NameFor(x => x.IsAllowedToEditListValue)"
                                   value="true"
                                   checked="checked" />
                            @Html.LabelFor(model => model.IsAllowedToEditListValue)
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Regex, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.Regex, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Regex, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.RegexValidationErrorMessage, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.RegexValidationErrorMessage, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.RegexValidationErrorMessage, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.MinLength, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.MinLength, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MinLength, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.MaxLength, new { @class = "control-label" })
                            <div class="text-field">
                                @Html.EditorFor(model => model.MaxLength, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MaxLength, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group checkbox">
                            <input type="checkbox"
                                   id="@Html.NameFor(x => x.IsEnabled)"
                                   name="@Html.NameFor(x => x.IsEnabled)"
                                   value="true"
                                   checked="checked" />
                            @Html.LabelFor(model => model.IsEnabled)
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">@Resources.Cancel</button>
                    <button type="button" class="btn btn-submit submit">@Resources.Save</button>
                </div>
            </div>
        }
    </div>
</div>

