@using TicketDesk.Localization.Client
@model TicketDesk.Web.Client.Areas.Admin.Models.CustomField.CustomFieldsViewModel

@{
    ViewBag.Title = "Custom Field Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    <link href="~/src/libs/jquery.DataTable/datatables.min.css" rel="stylesheet" />
    <link href="~/src/libs/jquery.DataTable/fixedHeader.dataTables.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/jquery.DataTable/datatables.min.js"></script>
    <script src="~/src/libs/jquery.DataTable/dataTables.fixedHeader.min.js"></script>
    <script src="~/src/js/admin/dataTableCommon.js"></script>
    <script src="~/src/js/admin/customfield/customfield.js" type="text/javascript"></script>
}

<div class="body-content">
    <section class="hidden">
        <p id="item-created-message">@Resources.ItemCreatedMessage</p>
        <p id="item-updated-message">@Resources.ItemUpdatedMessage</p>
    </section>

    <div id="dynamic-modals"></div>

    <h2 class="page-title">@ViewBag.Title</h2>

    <section class="filter-form">
        @using (Html.BeginForm("ListCustomField", "CustomFields", FormMethod.Post, new { @class = "filter-row" }))
        {
            <div class="select-group">
                @Html.LabelFor(x => x.SelectedTicketCategoryType)
                <div class="select-group">
                    @Html.EnumDropDownListFor(x => x.SelectedTicketCategoryType, "--Select one type--", new { @class = "form-control" })
                </div>
            </div>

            <div class="button-filter">
                <button type="submit" class="btn btn-submit">@Resources.Submit</button>
            </div>
        }
    </section>

    <section class="table" id="data-list"></section>

    @*<section>
            <h2>@ViewBag.Title</h2>
        </section>

        <section>
            <a href="@Url.Action("Add","CustomFields")" class="btn btn-success">Add new</a>
        </section>

        <section>
            <ul class="nav nav-tabs">
                @foreach (var ticketCategory in Model.TicketCategoryWithCustomFields)
                {
                    var activeClass = ticketCategory.CategoryId == Model.SelectedCategoryId ? "active" : "";

                    <li class="@activeClass"><a href="@Url.Action("Index", "CustomFields", new { id = ticketCategory.CategoryId })">@ticketCategory.Name</a></li>
                }
            </ul>

            @if (Model.CustomFields.Any())
            {
                <table class="table table-bordered text-info">
