                                }
                                else
                                {
                                    @item.Values
                                }
                            </td>
                            <td>
                                @if (item.Values_vi != null && item.Values_vi.Contains("\r\n"))
                                {
                                    var values = Regex.Split(item.Values_vi, "\r\n");
                                    foreach (var val in values)
