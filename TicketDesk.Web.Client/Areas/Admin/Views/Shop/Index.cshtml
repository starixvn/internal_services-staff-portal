@using System.Web.Optimization
@model TicketDesk.Web.Client.Areas.Admin.Models.ShopManagement.ShopFilterViewModel

@{
    ViewBag.Title = "Shop Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section css
{
    @Styles.Render("~/content/shop-management")
}

@section scripts
{
    @Scripts.Render("~/bundles/shop-management")
}

<h2 class="page-title">@ViewBag.Title</h2>

<section class="filter-form">
    @using (Html.BeginForm("GetListShop", "Shop", FormMethod.Post, new { @class = "filter-row", id = "filterForm" }))
    {
        <div class="text-field">
            @Html.LabelFor(x => x.ShopName)
            <div class="text-field">
                @Html.TextBoxFor(x => x.ShopName, new { @class = "form-control" })
                @Html.HiddenFor(x => x.ShopId, new { @class = "form-control" })
            </div>
        </div>

        <div class="dropdown-small">
            @Html.LabelFor(x => x.ActiveState)
            @Html.EnumDropDownListFor(x => x.ActiveState, new { @class = "form-control" })
        </div>

        <div class="button-filter">
            <button type="submit" class="btn btn-submit">Submit</button>
        </div>
    }
</section>

@if (Model.IsHostPermission)
{
    <div class="table-actions">
        <a class="btn btn-create create"><span class="icon-add"></span>Create New Shop</a>
    </div>
}

<section class="table" id="shopList"></section>

<!-- Create New Item -->
<div class="modal fade" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" id="createModal">
    <div class="modal-dialog small-modal" role="document">
        <div class="modal-content -has-title" id="createModalContent">
        </div>
    </div>
</div>

<!-- Edit Item -->
<div class="modal fade" role="dialog" aria-labelledby="modalUpdateLabel" data-backdrop="static" id="editModal">
    <div class="modal-dialog small-modal" role="document">
        <div class="modal-content -has-title" id="editModalContent">
        </div>
    </div>
</div>