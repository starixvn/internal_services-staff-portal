@using TicketDesk.Core.Enumerations
@using TicketDesk.Domain
@using TicketDesk.Web.Client.Areas.Admin.Models.Announcements
@using TicketDesk.Web.Client.Infrastructure.Helpers
@model NewAnnouncementViewModel

@using (Html.BeginForm(Model.ActionType.ToString(), "Announcement", FormMethod.Post, new { id = "modal-form" }))
{
    @Html.HiddenFor(x => x.Announcement.Id)

    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                @{
                    var title = Model.ModalId.GetDisplayName();
                    if (Model.ModalId == ModalId.EditAnnouncementModal)
                    {
                        title = title + " " + Model.Announcement.Id;
                    }
                }
                <h4 class="modal-title">@title</h4>
            </div>
            <div class="modal-body">

                @Html.AntiForgeryToken()

                <div class="form">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Announcement.PublishedDateTime, new { @class = "control-label" })
                        <div class="date-time">
                            @Html.TextBoxFor(model => model.Announcement.PublishedDateTime, "{0:MM-dd-yyyy hh:mm tt}", new { @class = "datetimepicker form-control", id = "announcement-date" })
                            <span class="icon-calendar"></span>
                            @Html.ValidationMessageFor(model => model.Announcement.PublishedDateTime, "", new { @class = "text-danger" })
                        </div>
                        <button class="btn btn-getCurrent" type="button" id="set-current-datetime-button">Get Current Date/Time</button>
                    </div>

                    <div class="form-group">
                        @Html.RequiredLabelFor(model => model.Announcement.Message, new { @class = "control-label text-content" }, true)
                        <div class="text-content">
                            @Html.TextAreaFor(model => model.Announcement.Message, new { @class = "form-control", placeholder = "User input the announcement into this textbox" })
                            @Html.ValidationMessageFor(model => model.Announcement.Message, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group checkbox">
                        @{
                            if (Model.Announcement.Type == AnnouncementType.Important)
                            {
                                <input type="checkbox"
                                       id="@Html.NameFor(x => x.IsImportant)"
                                       name="@Html.NameFor(x => x.IsImportant)"
                                       value="true"
                                       checked="checked"/>
                            }
                            else
                            {
                                <input type="checkbox"
                                       id="@Html.NameFor(x => x.IsImportant)"
                                       name="@Html.NameFor(x => x.IsImportant)"
                                       value="true"/>
                            }
                        }
                        @Html.LabelFor(model => model.IsImportant)
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">@Model.ActionType.GetDisplayName()</button>
            </div>
        </div>
    </div>
}