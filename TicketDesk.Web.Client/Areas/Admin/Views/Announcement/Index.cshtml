@using TicketDesk.Domain
@using TicketDesk.Domain.Model
@using TicketDesk.Web.Client.Areas.Admin.Models.Announcements
@using TicketDesk.Core.Enumerations
@model AnnouncementViewModel

@{
    ViewBag.Title = "Announcement Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="page-title">@ViewBag.Title</h2>

@section css
{
    <link href="~/src/libs/datetimepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
    <link href="~/src/libs/jquery.DataTable/datatables.min.css" rel="stylesheet" />
    <link href="~/src/libs/jquery.DataTable/fixedHeader.dataTables.min.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/src/libs/datetimepicker/moment.js"></script>
    <script src="~/src/libs/datetimepicker/bootstrap-datetimepicker.js"></script>
    <script src="~/src/js/admin/announcement/announcementsindex.js"></script>
    <script src="~/src/libs/jquery.DataTable/datatables.min.js"></script>
    <script src="~/src/libs/jquery.DataTable/dataTables.fixedHeader.min.js"></script>
}

<div id="announcement-modal">
    <!--edit announcement modal place holder-->
</div>

<div class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" id="confirm-popup">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <p class="message"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel dismiss-all" data-dismiss="modal">Cancel</button>
                <button type="button" id="confirm-btn" class="btn btn-primary">Publish</button>
            </div>
        </div>
    </div>
</div>

<!--Filter-->
<section class="filter-form">
    @using (Html.BeginForm("Index", "Announcement", FormMethod.Get, new { @class = "filter-row" }))
    {
        <div class="date-time">
            @Html.LabelFor(x => x.PublishedFrom)
            <div class="date-time">
                @Html.TextBoxFor(x => x.PublishedFrom, new { @class = "datepicker start form-control" })
                <span class="icon-calendar"></span>
            </div>
        </div>
        <div class="date-time">
            @Html.LabelFor(x => x.PublishedTo)
            <div class="date-time">
                @Html.TextBoxFor(x => x.PublishedTo, new { @class = "datepicker end form-control" })
                <span class="icon-calendar"></span>
            </div>
        </div>
        <div class="dropdown-small">
            @Html.LabelFor(x => x.Status)
            @Html.EnumDropDownListFor(x => x.Status, "All", new { @class = "form-control" })
        </div>
        <div class="dropdown-small">
            @Html.LabelFor(x => x.State)
            @Html.EnumDropDownListFor(x => x.State, "All", new { @class = "form-control" })
        </div>

        <div class="button-filter">
            <button type="submit" class="btn btn-submit">Submit</button>
        </div>
    }
</section>

<div class="table-actions">
    <a class="btn btn-create create"
       data-toggle="modal"
       href="#"
       data-href="@Url.Action("Create", "Announcement")"
       data-modalid="#@ModalId.CreateAnnouncementModal.ToString()"><span class="icon-add"></span>@ModalId.CreateAnnouncementModal.GetDisplayName()</a>
</div>

<!--Table-->
<section class="table" id="announcement-table">
    
</section>