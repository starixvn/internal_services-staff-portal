@using TicketDesk.Localization.Client
@model int[]

<div class="modal fade" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Publish", "Announcement", FormMethod.Post))
            {
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">Announcement Publish</h4>
                </div>
                <div class="modal-body">
                    @{
                        var message = Model.Length > 1
                            ? Resources.PublishMultipleAnnouncementMessage
                            : Resources.PublishSingleAnnouncementMessage;
                    }

                    <p>@message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel dismiss-all" data-dismiss="modal">@Resources.Cancel</button>
                    <button type="submit" class="btn btn-primary">@Resources.Publish</button>
                </div>
            }
        </div>
    </div>
</div>